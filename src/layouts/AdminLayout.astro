---
import "@/styles/global.css";
import { Toaster } from "@/components/ui/sonner";

interface Props {
  title: string;
  activeMenu?: string;
}

const { title, activeMenu = "dashboard" } = Astro.props;

const menuItems = [
  { id: "dashboard", label: "数据概览", href: "/admin", icon: "chart" },
  { id: "users", label: "用户管理", href: "/admin/users", icon: "users" },
  { id: "tasks", label: "任务管理", href: "/admin/tasks", icon: "tasks" },
  { id: "works", label: "作品管理", href: "/admin/works", icon: "image" },
  { id: "inspirations", label: "灵感管理", href: "/admin/inspirations", icon: "stars" },
  { id: "appeals", label: "申诉管理", href: "/admin/appeals", icon: "alert" },
  { id: "finance", label: "资金管理", href: "/admin/finance", icon: "wallet" },
  { id: "database", label: "数据表管理", href: "/admin/database", icon: "database" },
  { id: "api_debug", label: "接口调试", href: "/admin/api_debug", icon: "terminal" },
  ];

const bottomMenuItems = [
  { id: "logout", label: "退出登录", href: "#", icon: "logout" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - 创意喵管理后台</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="admin-layout">
      <aside class="sidebar">
        <div class="sidebar-header">
          <a href="/admin" class="brand">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
            <span>创意喵</span>
          </a>
        </div>

        <nav class="sidebar-nav">
          <ul class="nav-list">
            {
              menuItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={["nav-link", { active: activeMenu === item.id }]}
                  >
                    {item.id === "dashboard" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="3" y="3" width="7" height="9"></rect>
                        <rect x="14" y="3" width="7" height="5"></rect>
                        <rect x="14" y="12" width="7" height="9"></rect>
                        <rect x="3" y="16" width="7" height="5"></rect>
                      </svg>
                    )}
                    {item.id === "users" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                      </svg>
                    )}
                    {item.id === "tasks" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="8" y1="6" x2="21" y2="6"></line>
                        <line x1="8" y1="12" x2="21" y2="12"></line>
                        <line x1="8" y1="18" x2="21" y2="18"></line>
                        <line x1="3" y1="6" x2="3.01" y2="6"></line>
                        <line x1="3" y1="12" x2="3.01" y2="12"></line>
                        <line x1="3" y1="18" x2="3.01" y2="18"></line>
                      </svg>
                    )}
                    {item.id === "works" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                      </svg>
                    )}
                    {item.id === "inspirations" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                      </svg>
                    )}
                    {item.id === "appeals" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                      </svg>
                    )}
                    {item.id === "finance" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                      </svg>
                    )}
                    {item.id === "database" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                      </svg>
                    )}
                    {item.id === "api_debug" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="4 17 10 11 4 5"></polyline>
                        <line x1="12" y1="19" x2="20" y2="19"></line>
                      </svg>
                    )}
                    <span data-menu={item.id}>{item.label}</span>
                    <span class="nav-count text-xs ml-1 opacity-60"></span>
                    {item.id === "tasks" && (
                      <span class="badge bg-warning text-gray-900" id="pending-task-badge"></span>
                    )}
                    {item.id === "appeals" && (
                      <span class="badge bg-warning text-gray-900" id="pending-appeal-badge"></span>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="nav-bottom">
            <ul class="nav-list">
              {
                bottomMenuItems.map((item) => (
                  <li>
                    <a href={item.href} class="nav-link" id="logout-btn">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                      </svg>
                      <span>{item.label}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </nav>
      </aside>

      <main class="main-content">
        <header class="topbar">
          <div class="breadcrumb">
            <span class="breadcrumb-item">
              <a href="/admin">管理后台</a>
            </span>
            <span class="breadcrumb-sep">/</span>
            <span class="breadcrumb-item active">{title}</span>
          </div>
          <div class="user-info">
            <span id="admin-username">管理员</span>
          </div>
        </header>

        <div class="page-content">
          <slot />
        </div>
      </main>
    </div>

    <Toaster client:load />

    <script>
      import { api } from "@/lib/api";

      // Check auth on page load
      document.addEventListener("DOMContentLoaded", () => {
        const token = api.getToken();
        if (!token) {
          window.location.href = "/admin/login";
          return;
        }

        // Load username from localStorage
        const username = localStorage.getItem("username");
        if (username) {
          const usernameEl = document.getElementById("admin-username");
          if (usernameEl) usernameEl.textContent = username;
        }

        // Load counts for sidebar badges
        loadCounts();
      });

      async function loadCounts() {
        const token = api.getToken();
        if (!token) return;

        try {
          const res = await api.getStats();
          if (res.code === 0 && res.data) {
            const counts = [
              { menu: "users", value: res.data.total_users },
              { menu: "tasks", value: res.data.total_tasks },
              { menu: "works", value: res.data.total_works },
            ];
            counts.forEach(({ menu, value }) => {
              const el = document.querySelector(`[data-menu="${menu}"] .nav-count`);
              if (el) el.textContent = String(value);
            });
          }
        } catch (e) {
          console.error("Load counts failed:", e);
        }

        // Load pending counts for badges
        try {
          const res = await api.getTasks({ status: 1 });
          if (res.code === 0 && res.data?.tasks?.length > 0) {
            const badge = document.getElementById("pending-task-badge");
            if (badge) {
              badge.textContent = String(res.data.tasks.length);
              badge.style.display = "inline-block";
            }
          }
        } catch (e) {
          console.error("Load pending tasks failed:", e);
        }

        try {
          const res = await api.getAppeals({ status: 1 });
          if (res.code === 0 && res.data?.appeals?.length > 0) {
            const badge = document.getElementById("pending-appeal-badge");
            if (badge) {
              badge.textContent = String(res.data.appeals.length);
              badge.style.display = "inline-block";
            }
          }
        } catch (e) {
          console.error("Load pending appeals failed:", e);
        }
      }

      // Logout handler
      document.getElementById("logout-btn")?.addEventListener("click", (e) => {
        e.preventDefault();
        api.setToken(null);
        localStorage.removeItem("token");
        localStorage.removeItem("admin_token");
        localStorage.removeItem("user_id");
        localStorage.removeItem("username");
        localStorage.removeItem("role");
        localStorage.removeItem("is_admin");
        localStorage.removeItem("current_role");
        window.location.href = "/admin/login";
      });
    </script>

    <style>
      :root {
        --sidebar-width: 220px;
        --topbar-height: 56px;
        --admin-primary: oklch(0.65 0.2 15);
        --admin-primary-hover: oklch(0.55 0.18 15);
        --admin-bg: oklch(0.97 0 0);
        --admin-sidebar-bg: oklch(1 0 0);
        --admin-border: oklch(0.922 0 0);
        --admin-text: oklch(0.145 0 0);
        --admin-text-muted: oklch(0.556 0 0);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-sans);
        background: var(--admin-bg);
        color: var(--admin-text);
        line-height: 1.5;
      }

      .admin-layout {
        display: flex;
        min-height: 100vh;
      }

      .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--sidebar-width);
        height: 100vh;
        background: var(--admin-sidebar-bg);
        border-right: 1px solid var(--admin-border);
        display: flex;
        flex-direction: column;
        z-index: 100;
      }

      .sidebar-header {
        padding: 1rem;
        border-bottom: 1px solid var(--admin-border);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--admin-primary);
        text-decoration: none;
        font-weight: 700;
        font-size: 1.1rem;
      }

      .brand svg {
        color: var(--admin-primary);
      }

      .sidebar-nav {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 0.75rem 0;
        overflow-y: auto;
      }

      .nav-list {
        list-style: none;
      }

      .nav-link {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 1rem;
        color: var(--admin-text-muted);
        text-decoration: none;
        font-size: 0.875rem;
        border-left: 3px solid transparent;
        transition: all 0.2s;
      }

      .nav-link:hover {
        background: color-mix(in oklch, var(--admin-primary) 5%, transparent);
        color: var(--admin-primary);
        border-left-color: var(--admin-primary);
      }

      .nav-link.active {
        background: color-mix(in oklch, var(--admin-primary) 10%, transparent);
        color: var(--admin-primary);
        border-left-color: var(--admin-primary);
      }

      .nav-link svg {
        flex-shrink: 0;
      }

      .badge {
        margin-left: auto;
        font-size: 0.7rem;
        padding: 0.15em 0.5em;
        border-radius: 9999px;
        background: var(--admin-primary);
        color: white;
        font-weight: 500;
      }

      .badge.bg-warning {
        background: oklch(0.75 0.15 70);
        color: oklch(0.15 0 0);
      }

      .main-content {
        margin-left: var(--sidebar-width);
        flex: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .topbar {
        height: var(--topbar-height);
        background: var(--admin-sidebar-bg);
        border-bottom: 1px solid var(--admin-border);
        padding: 0 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
      }

      .breadcrumb-item a {
        color: var(--admin-text-muted);
        text-decoration: none;
      }

      .breadcrumb-item a:hover {
        color: var(--admin-primary);
      }

      .breadcrumb-sep {
        color: var(--admin-text-muted);
      }

      .breadcrumb-item.active {
        color: var(--admin-text);
      }

      .user-info {
        font-size: 0.875rem;
        color: var(--admin-text-muted);
      }

      .page-content {
        padding: 1.5rem;
        flex: 1;
      }
    </style>
  </body>
</html>
