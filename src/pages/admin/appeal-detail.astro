---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Textarea } from "@/components/ui/textarea";
import { Button } from "@/components/ui/button";
import { Label } from "@/components/ui/label";
---

<AdminLayout title="申诉详情" activeMenu="appeals">
  <div class="appeal-detail-page">
    <div class="page-header">
      <a href="/admin/appeals" class="back-link">← 返回列表</a>
      <h1 class="page-title">申诉详情</h1>
    </div>

    <div id="appeal-container">
      <div class="loading">加载中...</div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";
  import { toast } from "sonner";

  const urlParams = new URLSearchParams(window.location.search);
  const appealId = urlParams.get("id");

  if (!appealId) {
    document.getElementById("appeal-container")!.innerHTML = `<div class="error-message">缺少申诉ID参数</div>`;
  }

  const statusMap: Record<number, { label: string; variant: string }> = {
    1: { label: "待处理", variant: "secondary" },
    2: { label: "已处理", variant: "default" },
    3: { label: "已关闭", variant: "outline" },
  };

  const typeMap: Record<number, string> = {
    1: "任务申诉",
    2: "提现申诉",
    3: "其他",
  };

  async function loadAppeal() {
    const container = document.getElementById("appeal-container");
    if (!container || !appealId) return;

    try {
      const res = await api.getAppealDetail(parseInt(appealId));
      if (res.code === 0) {
        const appeal = res.data.appeal;
        container.innerHTML = `
          <div class="detail-grid">
            <Card class="col-span-2">
              <CardHeader>
                <CardTitle>申诉信息</CardTitle>
              </CardHeader>
              <CardContent class="space-y-3">
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">申诉ID</span>
                  <span class="font-mono text-sm">${appeal.id}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">类型</span>
                  <Badge variant="outline">${typeMap[appeal.type] || "未知"}</Badge>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">状态</span>
                  <Badge variant="${statusMap[appeal.status]?.variant || "secondary"}">${statusMap[appeal.status]?.label || "未知"}</Badge>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">任务ID</span>
                  <a href="/admin/task-detail?id=${appeal.task_id}" class="text-primary hover:underline font-mono text-sm">${appeal.task_id}</a>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">认领ID</span>
                  <span class="font-mono text-sm">${appeal.claim_id}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">用户ID</span>
                  <a href="/admin/user-detail?id=${appeal.user_id}" class="text-primary hover:underline font-mono text-sm">${appeal.user_id}</a>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">创建时间</span>
                  <span class="text-sm">${appeal.created_at ? new Date(appeal.created_at).toLocaleString("zh-CN") : "-"}</span>
                </div>
                <div class="flex justify-between py-2">
                  <span class="text-muted-foreground text-sm">处理时间</span>
                  <span class="text-sm">${appeal.handle_at ? new Date(appeal.handle_at).toLocaleString("zh-CN") : "-"}</span>
                </div>
              </CardContent>
            </Card>

            <Card class="col-span-2">
              <CardHeader>
                <CardTitle>申诉原因</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="whitespace-pre-wrap text-sm">${appeal.reason || "无"}</div>
              </CardContent>
            </Card>

            ${appeal.reply ? `
            <Card class="col-span-2">
              <CardHeader>
                <CardTitle>处理回复</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="whitespace-pre-wrap text-sm">${appeal.reply}</div>
              </CardContent>
            </Card>
            ` : ""}

            ${appeal.status === 1 ? `
            <Card>
              <CardHeader>
                <CardTitle>处理申诉</CardTitle>
              </CardHeader>
              <CardContent class="space-y-4">
                <div class="space-y-2">
                  <Label for="handle-status">处理结果</Label>
                  <select id="handle-status" class="flex h-8 rounded-lg border border-input bg-transparent px-3 py-1 text-sm">
                    <option value="2">通过申诉</option>
                    <option value="3">拒绝申诉</option>
                  </select>
                </div>
                <div class="space-y-2">
                  <Label for="handle-reply">回复说明</Label>
                  <Textarea id="handle-reply" rows="4" placeholder="请输入处理说明..." />
                </div>
                <Button id="submit-handle" class="w-full">提交处理</Button>
              </CardContent>
            </Card>
            ` : ""}
          </div>
        `;

        document.getElementById("submit-handle")?.addEventListener("click", async () => {
          const status = parseInt((document.getElementById("handle-status") as HTMLSelectElement).value);
          const reply = (document.getElementById("handle-reply") as HTMLTextAreaElement).value;

          if (!reply.trim()) {
            toast.error("请输入处理说明");
            return;
          }

          if (!confirm("确定提交处理结果？")) return;

          try {
            const res = await api.handleAppeal(parseInt(appealId), status, reply);
            if (res.code === 0) {
              toast.success("处理成功");
              loadAppeal();
            } else {
              toast.error("处理失败: " + res.message);
            }
          } catch (e) {
            toast.error("处理失败");
          }
        });
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadAppeal();
  }
</script>

<style>
  .appeal-detail-page {
    max-width: 1200px;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .back-link {
    color: var(--admin-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  .back-link:hover {
    color: var(--admin-primary);
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .loading {
    text-align: center;
    padding: 3rem;
    color: var(--admin-text-muted);
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .col-span-2 {
    grid-column: span 2;
  }

  @media (max-width: 768px) {
    .col-span-2 {
      grid-column: span 1;
    }
  }

  .space-y-3 > * + * {
    margin-top: 0.75rem;
  }

  .space-y-4 > * + * {
    margin-top: 1rem;
  }

  .py-2 {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .border-b {
    border-bottom: 1px solid var(--admin-border);
  }

  .flex {
    display: flex;
  }

  .justify-between {
    justify-content: space-between;
  }

  .items-center {
    align-items: center;
  }

  .whitespace-pre-wrap {
    white-space: pre-wrap;
  }

  .w-full {
    width: 100%;
  }
</style>
