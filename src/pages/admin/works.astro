---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
---

<AdminLayout title="作品管理" activeMenu="works">
  <div class="works-page">
    <div class="page-header">
      <h1 class="page-title">作品管理</h1>
      <div class="filter-tabs" id="filter-tabs">
        <a href="#" class="filter-tab active" data-status="">全部</a>
        <a href="#" class="filter-tab" data-status="1">待审核</a>
        <a href="#" class="filter-tab" data-status="2">已通过</a>
        <a href="#" class="filter-tab" data-status="3">未通过</a>
      </div>
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="works-container">
          <div class="loading">加载中...</div>
        </div>
        <div class="pagination" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  let currentPage = 1;
  let currentStatus = "";

  const statusMap: Record<number, { label: string; variant: string }> = {
    1: { label: "待审核", variant: "secondary" },
    2: { label: "已通过", variant: "default" },
    3: { label: "未通过", variant: "destructive" },
  };

  async function loadWorks(page = 1, status = "") {
    const container = document.getElementById("works-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    try {
      const params: any = { page, page_size: 20 };
      if (status) params.status = parseInt(status);
      const res = await api.getWorks(params);

      if (res.code === 0) {
        const works = res.data.works || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (works.length === 0) {
          container.innerHTML = `<div class="empty-state">暂无数据</div>`;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <div class="overflow-x-auto">
            <table class="works-table">
              <thead class="works-table-header">
                <tr>
                  <th class="works-th">ID</th>
                  <th class="works-th">任务ID</th>
                  <th class="works-th">创作者ID</th>
                  <th class="works-th">内容</th>
                  <th class="works-th">图片</th>
                  <th class="works-th">状态</th>
                  <th class="works-th">创建时间</th>
                  <th class="works-th">操作</th>
                </tr>
              </thead>
              <tbody>
                ${works.map((work: any) => `
                  <tr class="works-tr">
                    <td class="works-td font-mono text-xs">${work.id}</td>
                    <td class="works-td font-mono text-xs">${work.task_id}</td>
                    <td class="works-td font-mono text-xs">${work.creator_id}</td>
                    <td class="works-td max-w-xs truncate text-muted">${work.content?.substring(0, 50) || "-"}</td>
                    <td class="works-td">${work.images?.length > 0 ? `<span class="text-muted">${work.images.length} 张</span>` : "-"}</td>
                    <td class="works-td">
                      <span class="works-badge works-badge-${statusMap[work.status]?.variant || "secondary"}">${statusMap[work.status]?.label || "未知"}</span>
                    </td>
                    <td class="works-td text-muted text-xs">${new Date(work.created_at).toLocaleDateString("zh-CN")}</td>
                    <td class="works-td">
                      <a href="/admin/work-detail?id=${work.id}" class="text-primary hover:underline text-sm">详情</a>
                    </td>
                  </tr>
                `).join("")}
              </tbody>
            </table>
          </div>
        `;

        const statusParam = status ? `&status=${status}` : "";
        paginationEl.innerHTML = totalPages > 1 ? `
          <a href="#" class="page-btn ${page <= 1 ? 'disabled' : ''}" data-page="${page - 1}${statusParam}">上一页</a>
          <span class="page-info">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
          <a href="#" class="page-btn ${page >= totalPages ? 'disabled' : ''}" data-page="${page + 1}${statusParam}">下一页</a>
        ` : "";
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  document.getElementById("filter-tabs")?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("filter-tab")) {
      e.preventDefault();
      document.querySelectorAll(".filter-tab").forEach(el => el.classList.remove("active"));
      target.classList.add("active");
      currentStatus = target.dataset.status || "";
      currentPage = 1;
      loadWorks(1, currentStatus);
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("page-btn") && !target.classList.contains("disabled")) {
      e.preventDefault();
      const pageMatch = target.dataset.page?.match(/^(\d+)(.*)$/);
      if (pageMatch) {
        currentPage = parseInt(pageMatch[1]);
        const newStatus = pageMatch[2]?.replace("&status=", "") || currentStatus;
        loadWorks(currentPage, newStatus);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    }
  });

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadWorks();
  }
</script>

<style>
  .works-page {
    max-width: 1400px;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .filter-tabs {
    display: flex;
    gap: 0.25rem;
    background: white;
    padding: 0.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--admin-border);
  }

  .filter-tab {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--admin-text-muted);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: all 0.2s;
  }

  .filter-tab:hover {
    color: var(--admin-text);
    background: var(--admin-bg);
  }

  .filter-tab.active {
    background: var(--admin-primary);
    color: white;
  }

  .loading, .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--admin-text-muted);
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
    margin: 1rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-top: 1px solid var(--admin-border);
  }

  .page-btn {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--admin-text);
    text-decoration: none;
    border: 1px solid var(--admin-border);
    border-radius: 0.375rem;
  }

  .page-btn:hover:not(.disabled) {
    border-color: var(--admin-primary);
    color: var(--admin-primary);
  }

  .page-btn.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .page-info {
    font-size: 0.875rem;
    color: var(--admin-text-muted);
  }

  /* Works table styles */
  .works-table {
    width: 100%;
    caption-side: bottom;
    font-size: 0.875rem;
  }

  .works-table-header {
    border-bottom: 1px solid var(--admin-border);
  }

  .works-th {
    height: 2.5rem;
    padding: 0.5rem;
    text-align: left;
    vertical-align: middle;
    font-weight: 500;
    white-space: nowrap;
    color: var(--admin-text);
  }

  .works-tr {
    border-bottom: 1px solid var(--admin-border);
    transition: background-color 0.2s;
  }

  .works-tr:hover {
    background-color: var(--admin-bg);
  }

  .works-td {
    padding: 0.5rem;
    vertical-align: middle;
    white-space: nowrap;
  }

  .works-badge {
    display: inline-flex;
    height: 1.25rem;
    width: fit-content;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid transparent;
    padding: 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .works-badge-default {
    background: var(--admin-primary);
    color: white;
  }

  .works-badge-secondary {
    background: var(--admin-secondary);
    color: var(--admin-text);
  }

  .works-badge-destructive {
    background: oklch(0.577 0.245 27.325 / 0.1);
    color: oklch(0.577 0.245 27.325);
  }

  .text-muted {
    color: var(--admin-text-muted);
  }

  .truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .max-w-xs {
    max-width: 20rem;
  }
</style>
