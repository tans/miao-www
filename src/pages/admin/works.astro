---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import { Tabs, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Button } from "@/components/ui/button";
import { Alert, AlertDescription } from "@/components/ui/alert";
---

<AdminLayout title="作品管理" activeMenu="works">
  <div class="max-w-[1400px]">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-semibold">作品管理</h1>
      <Tabs value="" id="filter-tabs" className="bg-white rounded-lg border p-1">
        <TabsList className="bg-transparent">
          <TabsTrigger value="" className="data-active:bg-primary data-active:text-primary-foreground">全部</TabsTrigger>
          <TabsTrigger value="1" className="data-active:bg-primary data-active:text-primary-foreground">待审核</TabsTrigger>
          <TabsTrigger value="2" className="data-active:bg-primary data-active:text-primary-foreground">已通过</TabsTrigger>
          <TabsTrigger value="3" className="data-active:bg-primary data-active:text-primary-foreground">未通过</TabsTrigger>
        </TabsList>
      </Tabs>
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="works-container">
          <div class="text-center py-12 text-muted-foreground">加载中...</div>
        </div>
        <div class="flex justify-center items-center gap-4 p-4 border-t" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  let currentPage = 1;
  let currentStatus = "";

  const statusMap: Record<number, { label: string; variant: "default" | "secondary" | "destructive" }> = {
    1: { label: "待审核", variant: "secondary" },
    2: { label: "已通过", variant: "default" },
    3: { label: "未通过", variant: "destructive" },
  };

  async function loadWorks(page = 1, status = "") {
    const container = document.getElementById("works-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    try {
      const params: any = { page, page_size: 20 };
      if (status) params.status = parseInt(status);
      const res = await api.getWorks(params);

      if (res.code === 0) {
        const works = res.data.works || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (works.length === 0) {
          container.innerHTML = `
            <Alert class="m-4">
              <AlertDescription>暂无数据</AlertDescription>
            </Alert>
          `;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>ID</TableHead>
                <TableHead>任务ID</TableHead>
                <TableHead>创作者ID</TableHead>
                <TableHead>内容</TableHead>
                <TableHead>图片</TableHead>
                <TableHead>状态</TableHead>
                <TableHead>创建时间</TableHead>
                <TableHead>操作</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              ${works.map((work: any) => `
                <TableRow>
                  <TableCell class="font-mono text-xs">${work.id}</TableCell>
                  <TableCell class="font-mono text-xs">${work.task_id}</TableCell>
                  <TableCell class="font-mono text-xs">${work.creator_id}</TableCell>
                  <TableCell class="max-w-64 truncate text-muted-foreground">${work.content?.substring(0, 50) || "-"}</TableCell>
                  <TableCell>${work.images?.length > 0 ? `<span class="text-muted-foreground">${work.images.length} 张</span>` : "-"}</TableCell>
                  <TableCell>
                    <Badge variant="${statusMap[work.status]?.variant || "secondary"}">${statusMap[work.status]?.label || "未知"}</Badge>
                  </TableCell>
                  <TableCell class="text-muted-foreground text-xs">${new Date(work.created_at).toLocaleDateString("zh-CN")}</TableCell>
                  <TableCell>
                    <a href="/admin/work-detail?id=${work.id}" class="text-primary hover:underline text-sm">详情</a>
                  </TableCell>
                </TableRow>
              `).join("")}
            </TableBody>
          </Table>
        `;

        if (totalPages > 1) {
          const statusParam = status ? `&status=${status}` : "";
          paginationEl.innerHTML = `
            <Button variant="outline" size="sm" ${page <= 1 ? 'disabled' : ''} data-page="${page - 1}${statusParam}">上一页</Button>
            <span class="text-sm text-muted-foreground">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
            <Button variant="outline" size="sm" ${page >= totalPages ? 'disabled' : ''} data-page="${page + 1}${statusParam}">下一页</Button>
          `;
        } else {
          paginationEl.innerHTML = "";
        }
      } else {
        container.innerHTML = `
          <Alert variant="destructive" class="m-4">
            <AlertDescription>${res.message}</AlertDescription>
          </Alert>
        `;
        paginationEl.innerHTML = "";
      }
    } catch (e) {
      container.innerHTML = `
        <Alert variant="destructive" class="m-4">
          <AlertDescription>加载失败</AlertDescription>
        </Alert>
      `;
      paginationEl.innerHTML = "";
    }
  }

  document.getElementById("filter-tabs")?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const trigger = target.closest("[data-slot=tabs-trigger]") as HTMLElement;
    if (trigger) {
      currentStatus = trigger.getAttribute("value") || "";
      currentPage = 1;
      loadWorks(1, currentStatus);
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest("button[data-page]");
    if (btn && !btn.hasAttribute("disabled")) {
      const pageBtn = btn as HTMLElement;
      const pageMatch = pageBtn.dataset.page?.match(/^(\d+)(.*)$/);
      if (pageMatch) {
        currentPage = parseInt(pageMatch[1]);
        const newStatus = pageMatch[2]?.replace("&status=", "") || currentStatus;
        loadWorks(currentPage, newStatus);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    }
  });

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadWorks();
  }
</script>
