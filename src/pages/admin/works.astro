---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import { FilterTabs } from "@/components/FilterTabs";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Alert, AlertDescription } from "@/components/ui/alert";
---

<AdminLayout title="作品管理" activeMenu="works">
  <div class="max-w-[1400px]">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-semibold">作品管理</h1>
      <div class="flex items-center gap-3">
        <Input type="search" placeholder="搜索作品ID/任务ID/创作者ID..." class="w-64" id="search-input" />
        <FilterTabs
          client:only="react"
          options={[
            { value: "", label: "全部" },
            { value: "1", label: "待审核" },
            { value: "2", label: "已通过" },
            { value: "3", label: "未通过" },
          ]}
          id="filter-tabs"
          className="mb-0"
          eventName="filter-tabs-change"
        />
      </div>
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="works-container">
          <div class="text-center py-12 text-muted-foreground">加载中...</div>
        </div>
        <div class="flex justify-center items-center gap-4 p-4 border-t" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";
  import { toast } from "sonner";

  let currentPage = 1;
  let currentStatus = "";
  let searchKeyword = "";
  let debounceTimer: ReturnType<typeof setTimeout>;

  const statusMap: Record<number, { label: string; variant: "default" | "secondary" | "destructive" }> = {
    1: { label: "待审核", variant: "secondary" },
    2: { label: "已通过", variant: "default" },
    3: { label: "未通过", variant: "destructive" },
  };

  async function loadWorks(page = 1, status = "") {
    const container = document.getElementById("works-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    container.innerHTML = `<div class="text-center py-12 text-muted-foreground">加载中...</div>`;

    try {
      const params: any = { page, page_size: 20 };
      if (status) params.status = parseInt(status);
      if (searchKeyword) {
        const num = parseInt(searchKeyword);
        if (!isNaN(num)) {
          params.keyword = num;
        }
      }
      const res = await api.getWorks(params);

      if (res.code === 0) {
        const works = res.data.works || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (works.length === 0) {
          container.innerHTML = `
            <Alert class="m-4">
              <AlertDescription>暂无数据${searchKeyword || status ? "，请调整筛选条件" : ""}</AlertDescription>
            </Alert>
          `;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>ID</TableHead>
                <TableHead>任务ID</TableHead>
                <TableHead>创作者ID</TableHead>
                <TableHead>内容</TableHead>
                <TableHead>图片</TableHead>
                <TableHead>状态</TableHead>
                <TableHead>创建时间</TableHead>
                <TableHead>操作</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              ${works.map((work: any) => `
                <TableRow>
                  <TableCell class="font-mono text-xs">${work.id}</TableCell>
                  <TableCell class="font-mono text-xs">${work.task_id}</TableCell>
                  <TableCell class="font-mono text-xs">${work.creator_id}</TableCell>
                  <TableCell class="max-w-64 truncate text-muted-foreground">${work.content?.substring(0, 50) || "-"}</TableCell>
                  <TableCell>${work.images?.length > 0 ? `<span class="text-muted-foreground">${work.images.length} 张</span>` : "-"}</TableCell>
                  <TableCell>
                    <Badge variant="${statusMap[work.review_result]?.variant || "secondary"}">${statusMap[work.review_result]?.label || "未知"}</Badge>
                  </TableCell>
                  <TableCell class="text-muted-foreground text-xs">${new Date(work.created_at).toLocaleDateString("zh-CN")}</TableCell>
                  <TableCell>
                    <div class="flex gap-2">
                      <a href="/admin/work-detail?id=${work.id}" class="text-primary hover:underline text-sm">详情</a>
                      ${work.review_result === 1 ? `
                        <button class="text-green-600 hover:underline text-sm" data-action="quick-approve" data-id="${work.id}">通过</button>
                        <button class="text-red-600 hover:underline text-sm" data-action="quick-reject" data-id="${work.id}">拒绝</button>
                      ` : ""}
                    </div>
                  </TableCell>
                </TableRow>
              `).join("")}
            </TableBody>
          </Table>
        `;

        if (totalPages > 1) {
          const statusParam = status ? `&status=${status}` : "";
          paginationEl.innerHTML = `
            <Button variant="outline" size="sm" ${page <= 1 ? "disabled" : ""} data-page="${page - 1}${statusParam}">上一页</Button>
            <span class="text-sm text-muted-foreground">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
            <Button variant="outline" size="sm" ${page >= totalPages ? "disabled" : ""} data-page="${page + 1}${statusParam}">下一页</Button>
          `;
        } else {
          paginationEl.innerHTML = "";
        }
      } else {
        container.innerHTML = `
          <Alert variant="destructive" class="m-4">
            <AlertDescription>${res.message}</AlertDescription>
          </Alert>
        `;
        paginationEl.innerHTML = "";
      }
    } catch (e) {
      container.innerHTML = `
        <Alert variant="destructive" class="m-4">
          <AlertDescription>加载失败</AlertDescription>
        </Alert>
      `;
      paginationEl.innerHTML = "";
    }
  }

  // Search with debounce
  document.getElementById("search-input")?.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      searchKeyword = target.value.trim();
      currentPage = 1;
      loadWorks(1, currentStatus);
    }, 300);
  });

  window.addEventListener("filter-tabs-change", (e: Event) => {
    const customEvent = e as CustomEvent<{ value: string }>
    currentStatus = customEvent.detail.value
    currentPage = 1
    loadWorks(1, currentStatus)
  })

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest("button[data-page]");
    if (btn && !btn.hasAttribute("disabled")) {
      const pageBtn = btn as HTMLElement;
      const pageMatch = pageBtn.dataset.page?.match(/^(\d+)(.*)$/);
      if (pageMatch) {
        currentPage = parseInt(pageMatch[1]);
        const newStatus = pageMatch[2]?.replace("&status=", "") || currentStatus;
        loadWorks(currentPage, newStatus);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    }
  });

  // Quick approve/reject handlers
  document.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;
    const action = target.dataset.action;
    const id = target.dataset.id;
    if (!action || !id) return;

    if (action === "quick-approve") {
      if (!confirm("确定通过该作品？")) return;
      try {
        const res = await api.updateWork(parseInt(id), { status: 2, review_result: 1 });
        if (res.code === 0) {
          toast.success("已通过");
          loadWorks(currentPage, currentStatus);
        } else {
          toast.error("操作失败: " + res.message);
        }
      } catch (e) {
        toast.error("操作失败");
      }
    } else if (action === "quick-reject") {
      if (!confirm("确定拒绝该作品？")) return;
      try {
        const res = await api.updateWork(parseInt(id), { status: 3, review_result: 2 });
        if (res.code === 0) {
          toast.success("已拒绝");
          loadWorks(currentPage, currentStatus);
        } else {
          toast.error("操作失败: " + res.message);
        }
      } catch (e) {
        toast.error("操作失败");
      }
    }
  });

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadWorks();
  }
</script>
