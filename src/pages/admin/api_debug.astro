---
import AdminLayout from "@/layouts/AdminLayout.astro";
---

<AdminLayout title="接口调试" activeMenu="api_debug">
  <div class="max-w-[1400px]">
    <!-- 顶部栏 -->
    <div class="flex items-center gap-3 mb-3 text-sm">
      <span class="text-muted-foreground">用户:</span>
      <select id="sim-user-select" class="h-7 px-2 rounded border border-input bg-transparent text-xs">
        <option value="">-- 手动输入Token --</option>
      </select>
      <span id="sim-user-btn-section" class="hidden">
        <button id="btn-get-token" class="text-xs text-blue-600 hover:underline">获取Token</button>
      </span>
      <span id="sim-user-info" class="hidden text-xs">
        <span id="sim-user-badge" class="text-green-600"></span>
        <button id="btn-clear-user" class="ml-2 text-muted-foreground hover:text-red-600">×</button>
      </span>
      <span id="sim-user-token-display" class="hidden ml-2">
        <code id="sim-user-token-preview" class="text-xs text-muted-foreground"></code>
      </span>
      <span class="ml-auto flex items-center gap-2">
        <input type="text" id="search-api" placeholder="搜索..." class="h-7 px-2 rounded border border-input bg-transparent text-xs w-32">
        <select id="filter-tag" class="h-7 px-2 rounded border border-input bg-transparent text-xs">
          <option value="">全部</option>
        </select>
        <button id="btn-expand-all" class="text-xs text-muted-foreground hover:text-foreground">展开</button>
        <button id="btn-collapse-all" class="text-xs text-muted-foreground hover:text-foreground">收起</button>
      </span>
    </div>

    <!-- Token提示 -->
    <div id="admin-token-status" class="text-xs text-muted-foreground mb-3"></div>

    <div id="api-loading" class="text-center py-8 text-muted-foreground text-sm">加载中...</div>
    <div id="api-container"></div>
  </div>
</AdminLayout>

<script>
  const API_BASE = '/api/v1';
  let openapiSpec: any = null;
  let simUserToken: string | null = null;
  let simUserInfo: any = null;
  let allUsers: any[] = [];

  // 挂载到 window 以便 HTML onclick 调用
  (window as any).getSimUserToken = getSimUserToken;
  (window as any).clearSimUser = clearSimUser;

  function getAdminToken(): string | null {
    return localStorage.getItem('admin_token');
  }

  async function loadUsersForSim() {
    const token = getAdminToken();
    if (!token) {
      document.getElementById('admin-token-status')!.textContent = '未登录';
      return;
    }
    document.getElementById('admin-token-status')!.textContent = '管理员已登录';

    try {
      const res = await fetch('/api/v1/admin/users?page=1&page_size=100', {
        headers: { 'Authorization': 'Bearer ' + token }
      });
      const data = await res.json();
      if (data.code === 0 && data.data) {
        allUsers = data.data.users || [];
        const select = document.getElementById('sim-user-select') as HTMLSelectElement;
        allUsers.forEach((user: any) => {
          const opt = document.createElement('option');
          opt.value = user.id;
          opt.textContent = `${user.username} (${user.role === 1 ? '创' : user.role === 2 ? '商' : '?'}) ID:${user.id}`;
          select.appendChild(opt);
        });
      }
    } catch (e) {
      console.error('Load users failed:', e);
    }
  }

  function onUserSelect() {
    const select = document.getElementById('sim-user-select') as HTMLSelectElement;
    const btnSection = document.getElementById('sim-user-btn-section')!;
    const userInfo = document.getElementById('sim-user-info')!;
    const tokenDisplay = document.getElementById('sim-user-token-display')!;

    if (select.value) {
      btnSection.classList.remove('hidden');
      userInfo.classList.add('hidden');
      tokenDisplay.classList.add('hidden');
      simUserToken = null;
      simUserInfo = null;
    } else {
      btnSection.classList.add('hidden');
      userInfo.classList.add('hidden');
      tokenDisplay.classList.add('hidden');
      simUserToken = null;
      simUserInfo = null;
    }
  }

  async function getSimUserToken() {
    const select = document.getElementById('sim-user-select') as HTMLSelectElement;
    const userId = select.value;
    if (!userId) { alert('请选择用户'); return; }

    const adminToken = getAdminToken();
    if (!adminToken) { alert('管理员未登录'); return; }

    try {
      const res = await fetch(`/api/v1/admin/users/${userId}/token`, {
        headers: { 'Authorization': 'Bearer ' + adminToken }
      });
      const data = await res.json();

      if (data.code === 0 && data.data && data.data.token) {
        simUserToken = data.data.token;
        simUserInfo = data.data.user;

        document.getElementById('sim-user-btn-section')!.classList.add('hidden');
        document.getElementById('sim-user-info')!.classList.remove('hidden');
        document.getElementById('sim-user-token-display')!.classList.remove('hidden');

        const badge = document.getElementById('sim-user-badge')!;
        badge.textContent = `${simUserInfo.username} (ID:${simUserInfo.id})`;

        const preview = document.getElementById('sim-user-token-preview')!;
        preview.textContent = simUserToken;

        (document.querySelectorAll('[data-endpoint-token]') as NodeListOf<HTMLInputElement>).forEach(input => {
          input.value = simUserToken || '';
        });
      } else {
        alert(data.message || '获取Token失败');
      }
    } catch (e: any) {
      alert('获取Token失败: ' + e.message);
    }
  }

  function clearSimUser() {
    simUserToken = null;
    simUserInfo = null;
    (document.getElementById('sim-user-select') as HTMLSelectElement).value = '';
    document.getElementById('sim-user-btn-section')!.classList.add('hidden');
    document.getElementById('sim-user-info')!.classList.add('hidden');
    document.getElementById('sim-user-token-display')!.classList.add('hidden');
    (document.querySelectorAll('[data-endpoint-token]') as NodeListOf<HTMLInputElement>).forEach(input => { input.value = ''; });
  }

  async function loadAPI() {
    try {
      const res = await fetch('/docs/openapi.json');
      openapiSpec = await res.json();
      renderAPI(openapiSpec);
      document.getElementById('api-loading')!.style.display = 'none';
    } catch (e: any) {
      document.getElementById('api-loading')!.innerHTML = '<div class="text-red-600">加载API定义失败: ' + e.message + '</div>';
    }
  }

  function renderAPI(spec: any) {
    const container = document.getElementById('api-container')!;
    const tags = spec.tags || [];
    const paths = spec.paths || {};

    const tagFilter = document.getElementById('filter-tag') as HTMLSelectElement;
    tags.forEach((tag: any) => {
      const opt = document.createElement('option');
      opt.value = tag.name;
      opt.textContent = tag.name;
      tagFilter.appendChild(opt);
    });

    const tagPaths: Record<string, any[]> = {};
    Object.entries(paths).forEach(([path, methods]: [string, any]) => {
      Object.entries(methods).forEach(([method, info]: [string, any]) => {
        const tagName = (info.tags && info.tags[0]) || '其他';
        if (!tagPaths[tagName]) tagPaths[tagName] = [];
        tagPaths[tagName].push({ path, method, ...info });
      });
    });

    let html = '';
    tags.forEach((tag: any) => {
      const endpoints = tagPaths[tag.name] || [];
      if (endpoints.length === 0) return;
      html += `<div class="mb-4" data-tag="${tag.name}">
        <div class="text-sm font-semibold mb-2 text-primary border-b pb-1">${tag.name} <span class="text-xs bg-muted px-1.5 py-0.5 rounded">${endpoints.length}</span></div>`;
      endpoints.forEach((ep: any) => { html += renderEndpoint(ep); });
      html += '</div>';
    });

    const otherEndpoints = tagPaths['其他'] || [];
    if (otherEndpoints.length > 0) {
      html += `<div class="mb-4" data-tag="其他">
        <div class="text-sm font-semibold mb-2 text-muted-foreground border-b pb-1">其他 <span class="text-xs bg-muted px-1.5 py-0.5 rounded">${otherEndpoints.length}</span></div>`;
      otherEndpoints.forEach((ep: any) => { html += renderEndpoint(ep); });
      html += '</div>';
    }

    container.innerHTML = html;

    // 事件委托处理 endpoint 点击展开
    container.querySelectorAll('.endpoint-header').forEach((header) => {
      header.addEventListener('click', () => {
        const details = header.nextElementSibling as HTMLElement;
        details.classList.toggle('hidden');
      });
    });

    if (simUserToken) {
      (document.querySelectorAll('[data-endpoint-token]') as NodeListOf<HTMLInputElement>).forEach(input => { input.value = simUserToken || ''; });
    }
  }

  function renderEndpoint(ep: any) {
    const epId = 'ep-' + ep.method + '-' + ep.path.replace(/\//g, '_');
    const isAuth = (ep.security || []).length > 0;
    const params = ep.parameters || [];
    const hasReqBody = ep.requestBody;

    const methodColors: Record<string, string> = { get: 'bg-blue-600', post: 'bg-green-600', put: 'bg-orange-500', delete: 'bg-red-600', patch: 'bg-yellow-500' };

    let paramsHtml = '';
    if (params.length > 0) {
      params.forEach((p: any) => {
        paramsHtml += `<div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-mono w-24">${p.name}${p.required ? '<span class="text-red-500">*</span>' : ''}</span>
          <input type="text" class="flex-1 h-6 px-2 rounded border border-input bg-transparent text-xs font-mono" data-param="${p.name}" data-in="${p.in}" placeholder="${p.schema?.default || ''}">
        </div>`;
      });
    }

    let requestBodyHtml = '';
    if (hasReqBody) {
      const schema = hasReqBody.content?.['application/json']?.schema || {};
      requestBodyHtml = `<div class="mt-2">
        <textarea class="w-full h-20 font-mono text-xs rounded border border-input bg-transparent p-2" data-body placeholder='${JSON.stringify(generateExample(schema))}'></textarea>
      </div>`;
    }

    const authMark = isAuth ? '<span class="text-xs text-yellow-600">🔒</span>' : '<span class="text-xs text-muted-foreground">○</span>';
    const defaultToken = simUserToken || '';

    return `<div class="endpoint-card mb-2 border-l-2 border-l-primary bg-card" data-path="${ep.path}" data-method="${ep.method}">
      <div class="endpoint-header cursor-pointer px-3 py-1.5 bg-muted/50 flex items-center gap-2 hover:bg-muted text-sm">
        <span class="${methodColors[ep.method] || 'bg-gray-600'} font-bold px-1.5 py-0.5 rounded text-white text-xs">${ep.method.toUpperCase()}</span>
        <code class="flex-1 text-xs">${ep.path}</code>
        ${authMark}
        <span class="text-muted-foreground text-xs">${ep.summary || ''}</span>
      </div>
      <div class="p-3 hidden">
        <div class="flex items-center gap-2 mb-2">
          <input type="text" class="flex-1 h-7 px-2 rounded border border-input bg-transparent text-xs" data-endpoint-token id="token-${epId}" value="${defaultToken}" placeholder="Token">
          <button class="btn-send px-3 py-1 bg-primary text-primary-foreground text-xs rounded hover:bg-primary/90" data-method="${ep.method}" data-path="${ep.path}" data-epid="${epId}">发送</button>
          <button class="btn-clear-resp px-3 py-1 border border-input text-xs rounded hover:bg-muted" data-epid="${epId}">清空</button>
        </div>
        ${params.length > 0 ? `<div class="mb-2">${paramsHtml}</div>` : ''}
        ${requestBodyHtml}
        <div class="mt-2 bg-zinc-900 text-zinc-200 p-2 rounded text-xs font-mono max-h-48 overflow-auto" id="response-${epId}">点击发送查看响应...</div>
      </div>
    </div>`;
  }

  function generateExample(schema: any) {
    if (!schema?.properties) return '{}';
    const ex: any = {};
    Object.entries(schema.properties).forEach(([key, prop]: [string, any]) => {
      if (schema.required?.includes(key)) {
        if (prop.type === 'string') ex[key] = prop.example || prop.default || '';
        else if (prop.type === 'integer' || prop.type === 'number') ex[key] = prop.default || 0;
        else if (prop.type === 'boolean') ex[key] = false;
        else ex[key] = null;
      }
    });
    return JSON.stringify(ex);
  }

  async function sendRequest(method: string, path: string, epId: string) {
    let token = (document.getElementById('token-' + epId) as HTMLInputElement).value;
    const responseEl = document.getElementById('response-' + epId)!;
    const btn = responseEl.closest('.endpoint-card')!.querySelector('.btn-send') as HTMLButtonElement;

    if (!token && simUserToken) token = simUserToken;
    if (!token) { responseEl.innerHTML = '<span class="text-red-500">需要Token</span>'; return; }

    btn.classList.add('opacity-50', 'pointer-events-none');
    responseEl.textContent = '发送中...';

    const url = new URL(API_BASE + path, window.location.origin);
    const bodyObj: any = {};

    responseEl.closest('.endpoint-card')!.querySelectorAll('[data-param]').forEach((input) => {
      const el = input as HTMLInputElement;
      if (!el.value) return;
      if (el.dataset.in === 'query') url.searchParams.append(el.dataset.param!, el.value);
      else url.pathname = url.pathname.replace('{' + el.dataset.param + '}', el.value);
    });

    responseEl.closest('.endpoint-card')!.querySelectorAll('[data-body]').forEach((textarea) => {
      const el = textarea as HTMLTextAreaElement;
      if (el.value.trim()) {
        try { Object.assign(bodyObj, JSON.parse(el.value)); }
        catch (e: any) { responseEl.innerHTML = '<span class="text-red-500">JSON错误: ' + e.message + '</span>'; btn.classList.remove('opacity-50', 'pointer-events-none'); return; }
      }
    });

    try {
      const options: RequestInit = {
        method: method.toUpperCase(),
        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }
      };
      if (['POST', 'PUT', 'PATCH'].includes(options.method!) && Object.keys(bodyObj).length > 0) {
        options.body = JSON.stringify(bodyObj);
      }

      const start = Date.now();
      const res = await fetch(url.pathname + url.search, options);
      const latency = Date.now() - start;
      const data = await res.json();
      responseEl.innerHTML = `<span class="text-purple-400">[${res.status}] ${latency}ms</span>\n${JSON.stringify(data, null, 2)}`;
    } catch (e: any) {
      responseEl.innerHTML = '<span class="text-red-500">失败: ' + e.message + '</span>';
    }

    btn.classList.remove('opacity-50', 'pointer-events-none');
  }

  function clearResponse(epId: string) {
    const el = document.getElementById('response-' + epId)!;
    el.textContent = '点击发送查看响应...';
  }

  function expandAll() { document.querySelectorAll('.endpoint-card > div:last-child').forEach(el => el.classList.remove('hidden')); }
  function collapseAll() { document.querySelectorAll('.endpoint-card > div:last-child').forEach(el => el.classList.add('hidden')); }

  function filterAPI() {
    const keyword = (document.getElementById('search-api') as HTMLInputElement).value.toLowerCase();
    const tag = (document.getElementById('filter-tag') as HTMLSelectElement).value;

    document.querySelectorAll('.endpoint-card').forEach(card => {
      const path = (card as HTMLElement).dataset.path?.toLowerCase() || '';
      const matchesKeyword = path.includes(keyword);
      const matchesTag = !tag || (card.closest('[data-tag]') as HTMLElement)?.dataset.tag === tag;
      (card as HTMLElement).style.display = matchesKeyword && matchesTag ? '' : 'none';
    });

    document.querySelectorAll('[data-tag]').forEach(section => {
      const visibleCards = section.querySelectorAll('.endpoint-card:not([style]), .endpoint-card[style=""]');
      (section as HTMLElement).style.display = visibleCards.length > 0 ? '' : 'none';
    });
  }

  // 全局事件委托
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    if (target.id === 'btn-get-token') { getSimUserToken(); return; }
    if (target.id === 'btn-clear-user') { clearSimUser(); return; }
    if (target.id === 'btn-expand-all') { expandAll(); return; }
    if (target.id === 'btn-collapse-all') { collapseAll(); return; }

    if (target.classList.contains('btn-send')) {
      const btn = target as HTMLButtonElement;
      sendRequest(btn.dataset.method!, btn.dataset.path!, btn.dataset.epid!);
      return;
    }
    if (target.classList.contains('btn-clear-resp')) {
      clearResponse(target.getAttribute('data-epid')!);
      return;
    }
  });

  document.getElementById('search-api')?.addEventListener('input', filterAPI);
  document.getElementById('filter-tag')?.addEventListener('change', filterAPI);
  document.getElementById('sim-user-select')?.addEventListener('change', onUserSelect);

  // Init
  const token = getAdminToken();
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadUsersForSim();
    loadAPI();
  }
</script>
