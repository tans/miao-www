---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Textarea } from "@/components/ui/textarea";
import { Alert, AlertDescription } from "@/components/ui/alert";
---

<AdminLayout title="数据库管理" activeMenu="database">
  <div class="max-w-[1400px]">
    <h1 class="text-2xl font-semibold mb-6">数据库管理</h1>

    <Card class="mb-6">
      <CardHeader>
        <CardTitle>执行 SQL 查询</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="space-y-4">
          <div class="space-y-2">
            <Label htmlFor="sql-input">SQL 语句</Label>
            <Textarea id="sql-input" class="font-mono" rows="4" placeholder="SELECT * FROM users LIMIT 10;" />
          </div>
          <div class="flex gap-2">
            <Button id="execute-btn">执行查询</Button>
            <Button id="clear-btn" variant="outline">清空结果</Button>
          </div>
        </div>
      </CardContent>
    </Card>

    <Card class="mb-6">
      <CardHeader>
        <CardTitle>数据库表</CardTitle>
      </CardHeader>
      <CardContent class="p-0">
        <div id="tables-container">
          <div class="text-center py-8 text-muted-foreground">加载中...</div>
        </div>
      </CardContent>
    </Card>

    <Card>
      <CardHeader>
        <CardTitle>查询结果</CardTitle>
      </CardHeader>
      <CardContent class="p-0">
        <div id="results-container">
          <div class="text-center py-8 text-muted-foreground">请在上方输入 SQL 并执行</div>
        </div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";
  import { toast } from "sonner";

  async function loadTables() {
    const container = document.getElementById("tables-container");
    if (!container) return;

    try {
      const res = await api.getTables();
      if (res.code === 0) {
        const tables = res.data.tables || [];
        if (tables.length === 0) {
          container.innerHTML = `
            <Alert class="m-4">
              <AlertDescription>暂无数据表</AlertDescription>
            </Alert>
          `;
          return;
        }
        container.innerHTML = `
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 p-4">
            ${tables.map((table: string) => `
              <div class="flex flex-col items-center gap-2 p-4 bg-muted/30 border border-border rounded-lg cursor-pointer hover:border-primary hover:bg-primary/5 transition-colors" data-table="${table}">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground">
                  <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                  <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                  <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                </svg>
                <span class="font-medium text-sm text-center">${table}</span>
                <div class="flex gap-2">
                  <button class="text-xs px-2 py-1 bg-background border border-border rounded hover:border-primary hover:text-primary transition-colors" data-action="schema">结构</button>
                  <button class="text-xs px-2 py-1 bg-background border border-border rounded hover:border-primary hover:text-primary transition-colors" data-action="select">查询</button>
                </div>
              </div>
            `).join("")}
          </div>
        `;

        // Table card click handlers
        container.querySelectorAll("[data-table]").forEach(card => {
          const tableName = (card as HTMLElement).dataset.table;

          card.querySelector("[data-action='schema']")?.addEventListener("click", (e) => {
            e.stopPropagation();
            loadSchema(tableName!);
          });

          card.querySelector("[data-action='select']")?.addEventListener("click", (e) => {
            e.stopPropagation();
            const sqlInput = document.getElementById("sql-input") as HTMLTextAreaElement;
            sqlInput.value = `SELECT * FROM ${tableName} LIMIT 50;`;
          });
        });
      } else {
        container.innerHTML = `
          <Alert variant="destructive" class="m-4">
            <AlertDescription>${res.message}</AlertDescription>
          </Alert>
        `;
      }
    } catch (e) {
      container.innerHTML = `
        <Alert variant="destructive" class="m-4">
          <AlertDescription>加载失败</AlertDescription>
        </Alert>
      `;
    }
  }

  async function loadSchema(tableName: string) {
    const resultsContainer = document.getElementById("results-container");
    if (!resultsContainer) return;

    try {
      const res = await api.getTableSchema(tableName);
      if (res.code === 0) {
        const schema = res.data.schema;
        resultsContainer.innerHTML = `
          <div class="p-4">
            <h4 class="font-medium mb-4">${tableName} 表结构</h4>
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead>字段名</TableHead>
                  <TableHead>类型</TableHead>
                  <TableHead>可空</TableHead>
                  <TableHead>默认值</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                ${(schema.columns || []).map((col: any) => `
                  <TableRow>
                    <TableCell class="font-mono">${col.name}</TableCell>
                    <TableCell class="text-muted-foreground">${col.type}</TableCell>
                    <TableCell>${col.nullable ? "是" : "否"}</TableCell>
                    <TableCell class="text-muted-foreground">${col.default || "-"}</TableCell>
                  </TableRow>
                `).join("")}
              </TableBody>
            </Table>
          </div>
        `;
      } else {
        resultsContainer.innerHTML = `
          <Alert variant="destructive" class="m-4">
            <AlertDescription>${res.message}</AlertDescription>
          </Alert>
        `;
      }
    } catch (e) {
      resultsContainer.innerHTML = `
        <Alert variant="destructive" class="m-4">
          <AlertDescription>加载失败</AlertDescription>
        </Alert>
      `;
    }
  }

  async function executeQuery() {
    const sqlInput = document.getElementById("sql-input") as HTMLTextAreaElement;
    const resultsContainer = document.getElementById("results-container");
    if (!sqlInput || !resultsContainer) return;

    const sql = sqlInput.value.trim();
    if (!sql) {
      toast.error("请输入 SQL 语句");
      return;
    }

    // Basic validation for read-only queries
    const upperSql = sql.toUpperCase();
    if (!upperSql.startsWith("SELECT") && !upperSql.startsWith("SHOW") && !upperSql.startsWith("DESCRIBE")) {
      toast.error("仅允许 SELECT/SHOW/DESCRIBE 查询");
      return;
    }

    try {
      const res = await api.executeQuery(sql);
      if (res.code === 0) {
        const rows = res.data.result || [];
        if (rows.length === 0) {
          resultsContainer.innerHTML = `
            <Alert class="m-4">
              <AlertDescription>查询成功，但无返回数据</AlertDescription>
            </Alert>
          `;
          return;
        }

        const columns = Object.keys(rows[0]);
        resultsContainer.innerHTML = `
          <div class="px-4 py-3 bg-muted/30 border-b text-sm text-muted-foreground">返回 ${rows.length} 行</div>
          <div class="overflow-x-auto">
            <Table>
              <TableHeader>
                <TableRow>
                  ${columns.map(col => `<TableHead>${col}</TableHead>`).join("")}
                </TableRow>
              </TableHeader>
              <TableBody>
                ${rows.slice(0, 100).map(row => `
                  <TableRow>
                    ${columns.map(col => `<TableCell>${row[col] ?? "-"}</TableCell>`).join("")}
                  </TableRow>
                `).join("")}
              </TableBody>
            </Table>
          </div>
          ${rows.length > 100 ? `<div class="px-4 py-3 bg-muted/30 border-t text-sm text-muted-foreground">仅显示前 100 行</div>` : ""}
        `;
      } else {
        resultsContainer.innerHTML = `
          <Alert variant="destructive" class="m-4">
            <AlertDescription>${res.message}</AlertDescription>
          </Alert>
        `;
      }
    } catch (e) {
      resultsContainer.innerHTML = `
        <Alert variant="destructive" class="m-4">
          <AlertDescription>查询失败</AlertDescription>
        </Alert>
      `;
    }
  }

  // Event listeners
  document.getElementById("execute-btn")?.addEventListener("click", executeQuery);
  document.getElementById("clear-btn")?.addEventListener("click", () => {
    const resultsContainer = document.getElementById("results-container");
    if (resultsContainer) {
      resultsContainer.innerHTML = `<div class="text-center py-8 text-muted-foreground">请在上方输入 SQL 并执行</div>`;
    }
  });

  // Enter key in textarea
  document.getElementById("sql-input")?.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && e.ctrlKey) {
      executeQuery();
    }
  });

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadTables();
  }
</script>
