---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
---

<AdminLayout title="数据库管理" activeMenu="database">
  <div class="database-page">
    <h1 class="page-title">数据库管理</h1>

    <Card class="mb-6">
      <CardHeader>
        <CardTitle>执行 SQL 查询</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="sql-form">
          <div class="form-group">
            <Label for="sql-input">SQL 语句</Label>
            <textarea id="sql-input" class="sql-input" rows="4" placeholder="SELECT * FROM users LIMIT 10;"></textarea>
          </div>
          <div class="form-actions">
            <Button id="execute-btn">执行查询</Button>
            <Button id="clear-btn" variant="outline">清空结果</Button>
          </div>
        </div>
      </CardContent>
    </Card>

    <Card>
      <CardHeader>
        <CardTitle>数据库表</CardTitle>
      </CardHeader>
      <CardContent class="p-0">
        <div id="tables-container">
          <div class="loading">加载中...</div>
        </div>
      </CardContent>
    </Card>

    <Card class="mt-6">
      <CardHeader>
        <CardTitle>查询结果</CardTitle>
      </CardHeader>
      <CardContent class="p-0">
        <div id="results-container">
          <div class="empty-state">请在上方输入 SQL 并执行</div>
        </div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  async function loadTables() {
    const container = document.getElementById("tables-container");
    if (!container) return;

    try {
      const res = await api.getTables();
      if (res.code === 0) {
        const tables = res.data.tables || [];
        if (tables.length === 0) {
          container.innerHTML = `<div class="empty-state">暂无数据表</div>`;
          return;
        }
        container.innerHTML = `
          <div class="tables-grid">
            ${tables.map((table: string) => `
              <div class="table-card" data-table="${table}">
                <div class="table-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                  </svg>
                </div>
                <span class="table-name">${table}</span>
                <button class="btn-sm" data-action="schema">结构</button>
                <button class="btn-sm" data-action="select">查询</button>
              </div>
            `).join("")}
          </div>
        `;

        // Table card click handlers
        container.querySelectorAll(".table-card").forEach(card => {
          const tableName = (card as HTMLElement).dataset.table;

          card.querySelector("[data-action='schema']")?.addEventListener("click", (e) => {
            e.stopPropagation();
            loadSchema(tableName!);
          });

          card.querySelector("[data-action='select']")?.addEventListener("click", (e) => {
            e.stopPropagation();
            const sqlInput = document.getElementById("sql-input") as HTMLTextAreaElement;
            sqlInput.value = `SELECT * FROM ${tableName} LIMIT 50;`;
          });
        });
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  async function loadSchema(tableName: string) {
    const resultsContainer = document.getElementById("results-container");
    if (!resultsContainer) return;

    try {
      const res = await api.request<{ schema: any }>(`/api/v1/admin/tables/${tableName}/schema`);
      if (res.code === 0) {
        const schema = res.data.schema;
        resultsContainer.innerHTML = `
          <div class="schema-info">
            <h4>${tableName} 表结构</h4>
            <table class="data-table">
              <thead>
                <tr>
                  <th>字段名</th>
                  <th>类型</th>
                  <th>可空</th>
                  <th>默认值</th>
                </tr>
              </thead>
              <tbody>
                ${(schema.columns || []).map((col: any) => `
                  <tr>
                    <td class="font-mono">${col.name}</td>
                    <td class="text-muted">${col.type}</td>
                    <td>${col.nullable ? "是" : "否"}</td>
                    <td class="text-muted">${col.default || "-"}</td>
                  </tr>
                `).join("")}
              </tbody>
            </table>
          </div>
        `;
      } else {
        resultsContainer.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      resultsContainer.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  async function executeQuery() {
    const sqlInput = document.getElementById("sql-input") as HTMLTextAreaElement;
    const resultsContainer = document.getElementById("results-container");
    if (!sqlInput || !resultsContainer) return;

    const sql = sqlInput.value.trim();
    if (!sql) {
      alert("请输入 SQL 语句");
      return;
    }

    // Basic validation for read-only queries
    const upperSql = sql.toUpperCase();
    if (!upperSql.startsWith("SELECT") && !upperSql.startsWith("SHOW") && !upperSql.startsWith("DESCRIBE")) {
      alert("仅允许 SELECT/SHOW/DESCRIBE 查询");
      return;
    }

    try {
      const res = await api.executeQuery(sql);
      if (res.code === 0) {
        const rows = res.data.result || [];
        if (rows.length === 0) {
          resultsContainer.innerHTML = `<div class="empty-state">查询成功，但无返回数据</div>`;
          return;
        }

        const columns = Object.keys(rows[0]);
        resultsContainer.innerHTML = `
          <div class="results-info">返回 ${rows.length} 行</div>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  ${columns.map(col => `<th>${col}</th>`).join("")}
                </tr>
              </thead>
              <tbody>
                ${rows.slice(0, 100).map(row => `
                  <tr>
                    ${columns.map(col => `<td>${row[col] ?? "-"}</td>`).join("")}
                  </tr>
                `).join("")}
              </tbody>
            </table>
          </div>
          ${rows.length > 100 ? `<div class="results-info">仅显示前 100 行</div>` : ""}
        `;
      } else {
        resultsContainer.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      resultsContainer.innerHTML = `<div class="error-message">查询失败</div>`;
    }
  }

  // Event listeners
  document.getElementById("execute-btn")?.addEventListener("click", executeQuery);
  document.getElementById("clear-btn")?.addEventListener("click", () => {
    const resultsContainer = document.getElementById("results-container");
    if (resultsContainer) {
      resultsContainer.innerHTML = `<div class="empty-state">请在上方输入 SQL 并执行</div>`;
    }
  });

  // Enter key in textarea
  document.getElementById("sql-input")?.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && e.ctrlKey) {
      executeQuery();
    }
  });

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadTables();
  }
</script>

<style>
  .database-page {
    max-width: 1400px;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .mb-6 {
    margin-bottom: 1.5rem;
  }

  .mt-6 {
    margin-top: 1.5rem;
  }

  .loading, .empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--text-muted);
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
    margin: 1rem;
  }

  .sql-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sql-input {
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    font-family: monospace;
    font-size: 0.875rem;
    resize: vertical;
  }

  .sql-input:focus {
    outline: none;
    border-color: var(--primary);
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
  }

  .tables-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    padding: 1rem;
  }

  .table-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem;
    background: #fafafa;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .table-card:hover {
    border-color: var(--primary);
    background: rgba(233, 69, 96, 0.05);
  }

  .table-icon {
    color: var(--text-muted);
  }

  .table-name {
    font-weight: 500;
    font-size: 0.875rem;
    text-align: center;
  }

  .btn-sm {
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    background: white;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-sm:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .results-info {
    padding: 0.75rem 1rem;
    background: #fafafa;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .table-responsive {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .data-table th,
  .data-table td {
    padding: 0.625rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .data-table th {
    background: #fafafa;
    font-weight: 500;
    color: var(--text-muted);
    position: sticky;
    top: 0;
  }

  .data-table td {
    font-family: monospace;
  }

  .schema-info {
    padding: 1rem;
  }

  .schema-info h4 {
    font-size: 1rem;
    margin-bottom: 1rem;
  }
</style>
