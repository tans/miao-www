---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
---

<AdminLayout title="灵感管理" activeMenu="inspirations">
  <div class="inspirations-page">
    <div class="page-header">
      <h1 class="page-title">灵感管理</h1>
      <Button id="add-btn">添加灵感</Button>
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="inspirations-container">
          <div class="loading">加载中...</div>
        </div>
        <div class="pagination" id="pagination"></div>
      </CardContent>
    </Card>

    <!-- Modal -->
    <div id="modal" class="modal hidden" aria-hidden="true">
      <div class="modal-backdrop"></div>
      <div class="modal-content" role="dialog" aria-modal="true">
        <div class="modal-header">
          <h2 id="modal-title" class="text-lg font-semibold">添加灵感</h2>
          <button class="modal-close" id="modal-close" aria-label="关闭">×</button>
        </div>
        <form id="inspiration-form" class="space-y-4">
          <input type="hidden" id="inspiration-id" name="id" />
          <div class="space-y-2">
            <Label for="inspiration-title">标题</Label>
            <Input type="text" id="inspiration-title" name="title" required placeholder="请输入标题" />
          </div>
          <div class="space-y-2">
            <Label for="inspiration-content">内容</Label>
            <Textarea id="inspiration-content" name="content" rows="4" placeholder="请输入内容" />
          </div>
          <div class="space-y-2">
            <Label for="inspiration-cover">封面URL</Label>
            <Input type="text" id="inspiration-cover" name="cover_url" placeholder="https://..." />
          </div>
          <div class="space-y-2">
            <Label for="inspiration-status">状态</Label>
            <select id="inspiration-status" name="status" class="select-input">
              <option value="0">草稿</option>
              <option value="1">已发布</option>
              <option value="2">已下架</option>
            </select>
          </div>
          <div class="flex justify-end gap-3 pt-2">
            <Button type="button" variant="outline" id="cancel-btn">取消</Button>
            <Button type="submit">保存</Button>
          </div>
        </form>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";
  import { toast } from "sonner";

  let currentPage = 1;

  const statusMap: Record<number, { label: string; variant: string }> = {
    0: { label: "草稿", variant: "secondary" },
    1: { label: "已发布", variant: "default" },
    2: { label: "已下架", variant: "destructive" },
  };

  async function loadInspirations(page = 1) {
    const container = document.getElementById("inspirations-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    try {
      const res = await api.getInspirations({ page, page_size: 20 });

      if (res.code === 0) {
        const inspirations = res.data.inspirations || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (inspirations.length === 0) {
          container.innerHTML = `<div class="empty-state">暂无数据</div>`;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>ID</TableHead>
                <TableHead>标题</TableHead>
                <TableHead>封面</TableHead>
                <TableHead>状态</TableHead>
                <TableHead>点赞数</TableHead>
                <TableHead>创建时间</TableHead>
                <TableHead>操作</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              ${inspirations.map((item: any) => `
                <TableRow>
                  <TableCell class="font-mono text-xs">${item.id}</TableCell>
                  <TableCell class="max-w-xs truncate">${item.title || "-"}</TableCell>
                  <TableCell>${item.cover_url ? `<img src="${item.cover_url}" alt="封面" class="w-10 h-10 object-cover rounded-md border" />` : "-"}</TableCell>
                  <TableCell>
                    <Badge variant="${statusMap[item.status]?.variant || "secondary"}">${statusMap[item.status]?.label || "未知"}</Badge>
                  </TableCell>
                  <TableCell>${item.likes || 0}</TableCell>
                  <TableCell class="text-muted-foreground text-xs">${new Date(item.created_at).toLocaleDateString("zh-CN")}</TableCell>
                  <TableCell>
                    <div class="flex gap-2">
                      <button class="text-primary hover:underline text-sm" data-action="edit" data-id="${item.id}">编辑</button>
                      <button class="text-destructive hover:underline text-sm" data-action="delete" data-id="${item.id}">删除</button>
                    </div>
                  </TableCell>
                </TableRow>
              `).join("")}
            </TableBody>
          </Table>
        `;

        paginationEl.innerHTML = totalPages > 1 ? `
          <a href="#" class="page-btn ${page <= 1 ? 'disabled' : ''}" data-page="${page - 1}">上一页</a>
          <span class="page-info">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
          <a href="#" class="page-btn ${page >= totalPages ? 'disabled' : ''}" data-page="${page + 1}">下一页</a>
        ` : "";
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  // Modal handling
  const modal = document.getElementById("modal")!;
  const modalTitle = document.getElementById("modal-title")!;
  const form = document.getElementById("inspiration-form") as HTMLFormElement;

  function openModal(isEdit: boolean, data?: any) {
    modalTitle.textContent = isEdit ? "编辑灵感" : "添加灵感";
    (document.getElementById("inspiration-id") as HTMLInputElement).value = data?.id || "";
    (document.getElementById("inspiration-title") as HTMLInputElement).value = data?.title || "";
    (document.getElementById("inspiration-content") as HTMLTextAreaElement).value = data?.content || "";
    (document.getElementById("inspiration-cover") as HTMLInputElement).value = data?.cover_url || "";
    (document.getElementById("inspiration-status") as HTMLSelectElement).value = String(data?.status ?? 1);
    modal.classList.remove("hidden");
    modal.setAttribute("aria-hidden", "false");
  }

  function closeModal() {
    modal.classList.add("hidden");
    modal.setAttribute("aria-hidden", "true");
    form.reset();
  }

  document.getElementById("add-btn")?.addEventListener("click", () => openModal(false));
  document.getElementById("modal-close")?.addEventListener("click", closeModal);
  document.getElementById("cancel-btn")?.addEventListener("click", closeModal);
  document.querySelector(".modal-backdrop")?.addEventListener("click", closeModal);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = (document.getElementById("inspiration-id") as HTMLInputElement).value;
    const data = {
      title: (document.getElementById("inspiration-title") as HTMLInputElement).value,
      content: (document.getElementById("inspiration-content") as HTMLTextAreaElement).value,
      cover_url: (document.getElementById("inspiration-cover") as HTMLInputElement).value,
      status: parseInt((document.getElementById("inspiration-status") as HTMLSelectElement).value),
    };

    try {
      let res;
      if (id) {
        res = await api.updateInspiration(parseInt(id), data);
      } else {
        res = await api.createInspiration(data);
      }
      if (res.code === 0) {
        closeModal();
        loadInspirations(currentPage);
        toast.success("保存成功");
      } else {
        toast.error(res.message || "保存失败");
      }
    } catch (e) {
      toast.error("保存失败");
    }
  });

  document.getElementById("inspirations-container")?.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;
    const action = target.dataset.action;
    const id = target.dataset.id;

    if (!action || !id) return;

    if (action === "edit") {
      try {
        const res = await api.getInspirationDetail(parseInt(id));
        if (res.code === 0) {
          openModal(true, res.data.inspiration);
        }
      } catch (e) {
        toast.error("加载失败");
      }
    } else if (action === "delete") {
      if (!confirm("确定删除该灵感？")) return;
      try {
        const res = await api.deleteInspiration(parseInt(id));
        if (res.code === 0) {
          loadInspirations(currentPage);
          toast.success("删除成功");
        } else {
          toast.error(res.message || "删除失败");
        }
      } catch (e) {
        toast.error("删除失败");
      }
    }
  });

  document.getElementById("pagination")?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("page-btn") && !target.classList.contains("disabled")) {
      e.preventDefault();
      currentPage = parseInt(target.dataset.page || "1");
      loadInspirations(currentPage);
    }
  });

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadInspirations();
  }
</script>

<style>
  .inspirations-page {
    max-width: 1400px;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .loading, .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--admin-text-muted);
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
    margin: 1rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-top: 1px solid var(--admin-border);
  }

  .page-btn {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--admin-text);
    text-decoration: none;
    border: 1px solid var(--admin-border);
    border-radius: 0.375rem;
  }

  .page-btn:hover:not(.disabled) {
    border-color: var(--admin-primary);
    color: var(--admin-primary);
  }

  .page-btn.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .page-info {
    font-size: 0.875rem;
    color: var(--admin-text-muted);
  }

  /* Modal styles */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal.hidden {
    display: none;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .modal-content {
    position: relative;
    background: white;
    border-radius: 0.75rem;
    padding: 1.5rem;
    width: 100%;
    max-width: 500px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .modal-close {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    font-size: 1.5rem;
    cursor: pointer;
    border-radius: 0.375rem;
    color: var(--admin-text-muted);
  }

  .modal-close:hover {
    background: var(--admin-bg);
    color: var(--admin-text);
  }

  .space-y-4 > * + * {
    margin-top: 1rem;
  }

  .space-y-2 > * + * {
    margin-top: 0.5rem;
  }

  .select-input {
    flex: 1;
    height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--admin-border);
    border-radius: 0.375rem;
    font-size: 0.875rem;
    background: white;
  }

  .select-input:focus {
    outline: none;
    border-color: var(--admin-primary);
  }

  .flex {
    display: flex;
  }

  .justify-end {
    justify-content: flex-end;
  }

  .gap-3 {
    gap: 0.75rem;
  }

  .pt-2 {
    padding-top: 0.5rem;
  }

  .w-10 {
    width: 2.5rem;
  }

  .h-10 {
    height: 2.5rem;
  }

  .object-cover {
    object-fit: cover;
  }

  .rounded-md {
    border-radius: 0.375rem;
  }
</style>
