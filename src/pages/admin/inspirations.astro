---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { FilterTabs } from "@/components/FilterTabs";
import { InspirationModal } from "@/components/InspirationModal";
---

<AdminLayout title="灵感管理" activeMenu="inspirations">
  <div class="max-w-[1400px]">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-semibold">灵感管理</h1>
      <div class="flex items-center gap-3">
        <FilterTabs
          client:only="react"
          options={[
            { value: "", label: "全部" },
            { value: "0", label: "草稿" },
            { value: "1", label: "已发布" },
            { value: "2", label: "已下架" },
          ]}
          id="filter-tabs"
          className="mb-0"
          eventName="filter-tabs-change"
        />
        <Button id="add-btn">添加灵感</Button>
      </div>
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="inspirations-container">
          <div class="text-center py-12 text-muted-foreground">加载中...</div>
        </div>
        <div class="flex justify-center items-center gap-4 p-4 border-t" id="pagination"></div>
      </CardContent>
    </Card>

    <InspirationModal client:only="react" id="modal" />
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  let currentPage = 1;
  let currentStatus = "";

  const statusMap: Record<number, { label: string; variant: "default" | "secondary" | "destructive" }> = {
    0: { label: "草稿", variant: "secondary" },
    1: { label: "已发布", variant: "default" },
    2: { label: "已下架", variant: "destructive" },
  };

  async function loadInspirations(page = 1, status = "") {
    const container = document.getElementById("inspirations-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    try {
      const params: any = { page, page_size: 20 };
      if (status) params.status = parseInt(status);
      const res = await api.getInspirations(params);

      if (res.code === 0) {
        const inspirations = res.data.inspirations || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (inspirations.length === 0) {
          container.innerHTML = `
            <Alert class="m-4">
              <AlertDescription>暂无数据</AlertDescription>
            </Alert>
          `;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>ID</TableHead>
                <TableHead>标题</TableHead>
                <TableHead>封面</TableHead>
                <TableHead>状态</TableHead>
                <TableHead>点赞数</TableHead>
                <TableHead>创建时间</TableHead>
                <TableHead>操作</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              ${inspirations.map((item: any) => `
                <TableRow>
                  <TableCell class="font-mono text-xs">${item.id}</TableCell>
                  <TableCell class="max-w-xs truncate">${item.title || "-"}</TableCell>
                  <TableCell>${item.cover_url ? `<img src="${item.cover_url}" alt="封面" class="w-10 h-10 object-cover rounded-md border" />` : "-"}</TableCell>
                  <TableCell>
                    <Badge variant="${statusMap[item.status]?.variant || "secondary"}">${statusMap[item.status]?.label || "未知"}</Badge>
                  </TableCell>
                  <TableCell>${item.likes || 0}</TableCell>
                  <TableCell class="text-muted-foreground text-xs">${new Date(item.created_at).toLocaleDateString("zh-CN")}</TableCell>
                  <TableCell>
                    <div class="flex gap-2">
                      <button class="text-primary hover:underline text-sm" data-action="edit" data-id="${item.id}">编辑</button>
                      <button class="text-destructive hover:underline text-sm" data-action="delete" data-id="${item.id}">删除</button>
                    </div>
                  </TableCell>
                </TableRow>
              `).join("")}
            </TableBody>
          </Table>
        `;

        if (totalPages > 1) {
          const statusParam = status ? `&status=${status}` : "";
          paginationEl.innerHTML = `
            <Button variant="outline" size="sm" ${page <= 1 ? 'disabled' : ''} data-page="${page - 1}${statusParam}">上一页</Button>
            <span class="text-sm text-muted-foreground">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
            <Button variant="outline" size="sm" ${page >= totalPages ? 'disabled' : ''} data-page="${page + 1}${statusParam}">下一页</Button>
          `;
        } else {
          paginationEl.innerHTML = "";
        }
      } else {
        container.innerHTML = `
          <Alert variant="destructive" class="m-4">
            <AlertDescription>${res.message}</AlertDescription>
          </Alert>
        `;
        paginationEl.innerHTML = "";
      }
    } catch (e) {
      container.innerHTML = `
        <Alert variant="destructive" class="m-4">
          <AlertDescription>加载失败</AlertDescription>
        </Alert>
      `;
      paginationEl.innerHTML = "";
    }
  }

  // Open modal event handler
  function handleOpenModal(isEdit: boolean, data?: any) {
    window.dispatchEvent(new CustomEvent("inspiration:open-modal", { detail: { isEdit, data } }));
  }

  document.getElementById("add-btn")?.addEventListener("click", () => handleOpenModal(false));

  // Filter tabs handler
  window.addEventListener("filter-tabs-change", (e: Event) => {
    const customEvent = e as CustomEvent<{ value: string }>
    currentStatus = customEvent.detail.value
    currentPage = 1
    loadInspirations(1, currentStatus)
  })

  document.getElementById("inspirations-container")?.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;
    const action = target.dataset.action;
    const id = target.dataset.id;

    if (!action || !id) return;

    if (action === "edit") {
      try {
        const res = await api.getInspirationDetail(parseInt(id));
        if (res.code === 0) {
          handleOpenModal(true, res.data.inspiration);
        }
      } catch (e) {
        // handle error
      }
    } else if (action === "delete") {
      if (!confirm("确定删除该灵感？")) return;
      try {
        const res = await api.deleteInspiration(parseInt(id));
        if (res.code === 0) {
          loadInspirations(currentPage, currentStatus);
        } else {
          alert(res.message || "删除失败");
        }
      } catch (e) {
        alert("删除失败");
      }
    }
  });

  document.getElementById("pagination")?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest("button[data-page]");
    if (btn && !btn.hasAttribute("disabled")) {
      const pageBtn = btn as HTMLElement;
      const pageMatch = pageBtn.dataset.page?.match(/^(\d+)(.*)$/);
      if (pageMatch) {
        currentPage = parseInt(pageMatch[1]);
        const newStatus = pageMatch[2]?.replace("&status=", "") || currentStatus;
        loadInspirations(currentPage, newStatus);
      }
    }
  });

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadInspirations();
  }
</script>
