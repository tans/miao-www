---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import { Input } from "@/components/ui/input";
---

<AdminLayout title="用户管理" activeMenu="users">
  <div class="users-page">
    <div class="page-header">
      <h1 class="page-title">用户管理</h1>
      <Input type="search" placeholder="搜索用户..." class="w-64" id="search-input" />
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="users-container">
          <div class="loading">加载中...</div>
        </div>
        <div class="pagination" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  let currentPage = 1;

  const statusMap: Record<number, { label: string; variant: string }> = {
    1: { label: "正常", variant: "default" },
    2: { label: "禁用", variant: "destructive" },
    3: { label: "冻结", variant: "secondary" },
  };

  const roleMap: Record<number, string> = {
    1: "创作者",
    2: "商家",
    3: "管理员",
  };

  async function loadUsers(page = 1) {
    const container = document.getElementById("users-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    try {
      const res = await api.getUsers({ page, page_size: 20 });
      if (res.code === 0) {
        const users = res.data.users || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (users.length === 0) {
          container.innerHTML = `<div class="empty-state">暂无数据</div>`;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <div class="overflow-x-auto">
            <table class="users-table">
              <thead class="users-table-header">
                <tr>
                  <th class="users-table-head">ID</th>
                  <th class="users-table-head">用户名</th>
                  <th class="users-table-head">邮箱</th>
                  <th class="users-table-head">手机</th>
                  <th class="users-table-head">角色</th>
                  <th class="users-table-head">余额</th>
                  <th class="users-table-head">状态</th>
                  <th class="users-table-head">注册时间</th>
                  <th class="users-table-head">操作</th>
                </tr>
              </thead>
              <tbody>
                ${users.map((user: any) => `
                  <tr class="users-table-row">
                    <td class="users-table-cell font-mono text-xs">${user.id}</td>
                    <td class="users-table-cell font-medium">${user.username}</td>
                    <td class="users-table-cell text-muted">${user.email || "-"}</td>
                    <td class="users-table-cell">${user.phone || "-"}</td>
                    <td class="users-table-cell">
                      <span class="users-badge users-badge-default">${roleMap[user.role] || "未知"}</span>
                    </td>
                    <td class="users-table-cell font-mono">¥${(user.balance || 0).toFixed(2)}</td>
                    <td class="users-table-cell">
                      <span class="users-badge ${user.status === 1 ? 'users-badge-default' : user.status === 2 ? 'users-badge-destructive' : 'users-badge-secondary'}">${statusMap[user.status]?.label || "未知"}</span>
                    </td>
                    <td class="users-table-cell text-muted text-xs">${new Date(user.created_at).toLocaleDateString("zh-CN")}</td>
                    <td class="users-table-cell">
                      <a href="/admin/user-detail?id=${user.id}" class="text-primary hover:underline text-sm">详情</a>
                    </td>
                  </tr>
                `).join("")}
              </tbody>
            </table>
          </div>
        `;

        paginationEl.innerHTML = totalPages > 1 ? `
          <a href="#" class="page-btn ${page <= 1 ? 'disabled' : ''}" data-page="${page - 1}">上一页</a>
          <span class="page-info">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
          <a href="#" class="page-btn ${page >= totalPages ? 'disabled' : ''}" data-page="${page + 1}">下一页</a>
        ` : "";
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  // Pagination handler
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("page-btn") && !target.classList.contains("disabled")) {
      e.preventDefault();
      currentPage = parseInt(target.dataset.page || "1");
      loadUsers(currentPage);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  // Initial load
  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadUsers();
  }
</script>

<style>
  .users-page {
    max-width: 1400px;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .loading, .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--admin-text-muted);
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
    margin: 1rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-top: 1px solid var(--admin-border);
  }

  .page-btn {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--admin-text);
    text-decoration: none;
    border: 1px solid var(--admin-border);
    border-radius: 0.375rem;
  }

  .page-btn:hover:not(.disabled) {
    border-color: var(--admin-primary);
    color: var(--admin-primary);
  }

  .page-btn.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .page-info {
    font-size: 0.875rem;
    color: var(--admin-text-muted);
  }

  /* Users table styles */
  .users-table {
    width: 100%;
    caption-side: bottom;
    font-size: 0.875rem;
  }

  .users-table-header {
    border-bottom: 1px solid var(--admin-border);
  }

  .users-table-head {
    height: 2.5rem;
    padding: 0.5rem;
    text-align: left;
    vertical-align: middle;
    font-weight: 500;
    white-space: nowrap;
    color: var(--admin-text);
  }

  .users-table-row {
    border-bottom: 1px solid var(--admin-border);
    transition: background-color 0.2s;
  }

  .users-table-row:hover {
    background-color: var(--admin-bg);
  }

  .users-table-cell {
    padding: 0.5rem;
    vertical-align: middle;
    white-space: nowrap;
  }

  .users-badge {
    display: inline-flex;
    height: 1.25rem;
    width: fit-content;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid transparent;
    padding: 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .users-badge-default {
    background: var(--admin-primary);
    color: white;
  }

  .users-badge-secondary {
    background: var(--admin-secondary);
    color: var(--admin-text);
  }

  .users-badge-destructive {
    background: oklch(0.577 0.245 27.325 / 0.1);
    color: oklch(0.577 0.245 27.325);
  }

  .text-muted {
    color: var(--admin-text-muted);
  }
</style>
