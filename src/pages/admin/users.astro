---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import { Alert, AlertDescription } from "@/components/ui/alert";
---

<AdminLayout title="用户管理" activeMenu="users">
  <div class="max-w-[1400px]">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-semibold">用户管理</h1>
      <div class="flex items-center gap-3">
        <Input type="search" placeholder="搜索用户名/邮箱/手机..." class="w-64" id="search-input" />
        <select id="role-filter" class="flex h-8 rounded-lg border border-input bg-transparent px-3 py-1 text-sm">
          <option value="">全部角色</option>
          <option value="creator">创作者</option>
          <option value="business">商家</option>
          <option value="admin">管理员</option>
        </select>
        <select id="status-filter" class="flex h-8 rounded-lg border border-input bg-transparent px-3 py-1 text-sm">
          <option value="">全部状态</option>
          <option value="active">正常</option>
          <option value="disabled">禁用</option>
        </select>
        <Button variant="outline" size="sm" id="reset-btn">重置</Button>
      </div>
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="users-container">
          <div class="text-center py-12 text-muted-foreground">加载中...</div>
        </div>
        <div class="flex justify-center items-center gap-4 p-4 border-t" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";
  import { toast } from "sonner";

  let currentPage = 1;
  let searchKeyword = "";
  let roleFilter = "";
  let statusFilter = "";
  let debounceTimer: ReturnType<typeof setTimeout>;

  const statusMap: Record<number, { label: string; variant: "default" | "destructive" | "secondary" }> = {
    0: { label: "禁用", variant: "destructive" },
    1: { label: "正常", variant: "default" },
    2: { label: "冻结", variant: "secondary" },
  };

  const roleMap: Record<string, string> = {
    "creator": "创作者",
    "business": "商家",
    "admin": "管理员",
  };

  async function loadUsers(page = 1) {
    const container = document.getElementById("users-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    container.innerHTML = `<div class="text-center py-12 text-muted-foreground">加载中...</div>`;

    try {
      const params: Record<string, any> = { page, page_size: 20 };
      if (searchKeyword) params.keyword = searchKeyword;
      if (roleFilter) params.role = roleFilter;
      if (statusFilter) params.status = statusFilter === "active" ? 1 : (statusFilter === "disabled" ? 0 : statusFilter);

      const res = await api.getUsers(params);
      if (res.code === 0) {
        const users = res.data.users || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (users.length === 0) {
          container.innerHTML = `
            <Alert class="m-4">
              <AlertDescription>暂无数据${searchKeyword || roleFilter || statusFilter ? "，请调整筛选条件" : ""}</AlertDescription>
            </Alert>
          `;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>ID</TableHead>
                <TableHead>用户名</TableHead>
                <TableHead>邮箱</TableHead>
                <TableHead>手机</TableHead>
                <TableHead>角色</TableHead>
                <TableHead>余额</TableHead>
                <TableHead>信用分</TableHead>
                <TableHead>状态</TableHead>
                <TableHead>注册时间</TableHead>
                <TableHead>操作</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              ${users.map((user: any) => `
                <TableRow>
                  <TableCell class="font-mono text-xs">${user.id}</TableCell>
                  <TableCell class="font-medium">${user.username}</TableCell>
                  <TableCell class="text-muted-foreground">${user.email || "-"}</TableCell>
                  <TableCell>${user.phone || "-"}</TableCell>
                  <TableCell>
                    <Badge variant="secondary">${roleMap[user.role] || "未知"}</Badge>
                  </TableCell>
                  <TableCell class="font-mono">¥${(user.balance || 0).toFixed(2)}</TableCell>
                  <TableCell>
                    <span class="font-mono text-sm ${(user.credit_score || 0) < 60 ? "text-red-500" : "text-green-600"}">${user.credit_score || 0}</span>
                  </TableCell>
                  <TableCell>
                    <Badge variant="${statusMap[user.status]?.variant || "secondary"}">${statusMap[user.status]?.label || "未知"}</Badge>
                  </TableCell>
                  <TableCell class="text-muted-foreground text-xs">${new Date(user.created_at).toLocaleDateString("zh-CN")}</TableCell>
                  <TableCell>
                    <div class="flex gap-2">
                      <a href="/admin/user-detail?id=${user.id}" class="text-primary hover:underline text-sm">详情</a>
                      <button class="text-destructive hover:underline text-sm" data-action="toggle-status" data-id="${user.id}" data-current="${user.status}">
                        ${user.status === 1 ? "禁用" : "启用"}
                      </button>
                    </div>
                  </TableCell>
                </TableRow>
              `).join("")}
            </TableBody>
          </Table>
        `;

        if (totalPages > 1) {
          paginationEl.innerHTML = `
            <Button variant="outline" size="sm" ${page <= 1 ? "disabled" : ""} data-page="${page - 1}">上一页</Button>
            <span class="text-sm text-muted-foreground">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
            <Button variant="outline" size="sm" ${page >= totalPages ? "disabled" : ""} data-page="${page + 1}">下一页</Button>
          `;
        } else {
          paginationEl.innerHTML = "";
        }
      } else {
        container.innerHTML = `
          <Alert variant="destructive" class="m-4">
            <AlertDescription>${res.message}</AlertDescription>
          </Alert>
        `;
        paginationEl.innerHTML = "";
      }
    } catch (e) {
      container.innerHTML = `
        <Alert variant="destructive" class="m-4">
          <AlertDescription>加载失败</AlertDescription>
        </Alert>
      `;
      paginationEl.innerHTML = "";
    }
  }

  // Search with debounce
  document.getElementById("search-input")?.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      searchKeyword = target.value.trim();
      currentPage = 1;
      loadUsers(1);
    }, 300);
  });

  // Filter handlers
  document.getElementById("role-filter")?.addEventListener("change", (e) => {
    roleFilter = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    loadUsers(1);
  });

  document.getElementById("status-filter")?.addEventListener("change", (e) => {
    statusFilter = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    loadUsers(1);
  });

  // Reset button
  document.getElementById("reset-btn")?.addEventListener("click", () => {
    (document.getElementById("search-input") as HTMLInputElement).value = "";
    (document.getElementById("role-filter") as HTMLSelectElement).value = "";
    (document.getElementById("status-filter") as HTMLSelectElement).value = "";
    searchKeyword = "";
    roleFilter = "";
    statusFilter = "";
    currentPage = 1;
    loadUsers(1);
  });

  // Pagination handler
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest("button[data-page]");
    if (btn && !btn.hasAttribute("disabled")) {
      currentPage = parseInt(btn.getAttribute("data-page") || "1");
      loadUsers(currentPage);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  // Action handlers (toggle status)
  document.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;
    const action = target.dataset.action;
    if (action === "toggle-status") {
      const id = target.dataset.id;
      const current = parseInt(target.dataset.current || "1");
      if (!id) return;
      const newStatus = current === 1 ? 2 : 1;
      const actionText = newStatus === 1 ? "启用" : "禁用";
      if (!confirm(`确定${actionText}该用户？`)) return;
      try {
        const res = await api.updateUserStatus(parseInt(id), newStatus);
        if (res.code === 0) {
          toast.success(`已${actionText}`);
          loadUsers(currentPage);
        } else {
          toast.error("操作失败: " + res.message);
        }
      } catch (e) {
        toast.error("操作失败");
      }
    }
  });

  // Initial load
  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadUsers();
  }
</script>
