---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
---

<AdminLayout title="用户管理" activeMenu="users">
  <div class="users-page">
    <div class="page-header">
      <h1 class="page-title">用户管理</h1>
      <input type="search" placeholder="搜索用户..." class="search-input" id="search-input" />
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="users-container">
          <div class="loading">加载中...</div>
        </div>
        <div class="pagination" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  let currentPage = 1;
  let currentStatus = null;

  const statusMap: Record<number, { label: string; class: string }> = {
    1: { label: "正常", class: "bg-green-100 text-green-800" },
    2: { label: "禁用", class: "bg-red-100 text-red-800" },
    3: { label: "冻结", class: "bg-yellow-100 text-yellow-800" },
  };

  const roleMap: Record<number, string> = {
    1: "创作者",
    2: "商家",
    3: "管理员",
  };

  async function loadUsers(page = 1) {
    const container = document.getElementById("users-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    try {
      const res = await api.getUsers({ page, page_size: 20 });
      if (res.code === 0) {
        const users = res.data.users || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (users.length === 0) {
          container.innerHTML = `<div class="empty-state">暂无数据</div>`;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>用户名</th>
                <th>邮箱</th>
                <th>手机</th>
                <th>角色</th>
                <th>余额</th>
                <th>状态</th>
                <th>注册时间</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              ${users.map((user: any) => `
                <tr>
                  <td class="font-mono text-sm">${user.id}</td>
                  <td class="font-medium">${user.username}</td>
                  <td class="text-muted">${user.email || "-"}</td>
                  <td>${user.phone || "-"}</td>
                  <td><span class="badge-outline">${roleMap[user.role] || "未知"}</span></td>
                  <td class="font-mono">¥${(user.balance || 0).toFixed(2)}</td>
                  <td><span class="badge ${statusMap[user.status]?.class || "bg-gray-100"}">${statusMap[user.status]?.label || "未知"}</span></td>
                  <td class="text-muted text-sm">${new Date(user.created_at).toLocaleDateString("zh-CN")}</td>
                  <td><a href="/admin/user-detail?id=${user.id}" class="action-link">详情</a></td>
                </tr>
              `).join("")}
            </tbody>
          </table>
        `;

        paginationEl.innerHTML = totalPages > 1 ? `
          <a href="#" class="page-btn ${page <= 1 ? 'disabled' : ''}" data-page="${page - 1}">上一页</a>
          <span class="page-info">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
          <a href="#" class="page-btn ${page >= totalPages ? 'disabled' : ''}" data-page="${page + 1}">下一页</a>
        ` : "";
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  // Pagination handler
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("page-btn") && !target.classList.contains("disabled")) {
      e.preventDefault();
      currentPage = parseInt(target.dataset.page || "1");
      loadUsers(currentPage);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  // Initial load
  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadUsers();
  }
</script>

<style>
  .users-page {
    max-width: 1400px;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .search-input {
    width: 280px;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    font-size: 0.875rem;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--primary);
  }

  .loading, .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--text-muted);
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
    margin: 1rem;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
  }

  .data-table th,
  .data-table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .data-table th {
    background: #fafafa;
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .data-table td {
    font-size: 0.875rem;
  }

  .badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .badge-outline {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    font-size: 0.75rem;
  }

  .action-link {
    color: var(--primary);
    text-decoration: none;
  }

  .action-link:hover {
    text-decoration: underline;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-top: 1px solid var(--border);
  }

  .page-btn {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
  }

  .page-btn:hover:not(.disabled) {
    border-color: var(--primary);
    color: var(--primary);
  }

  .page-btn.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .page-info {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
