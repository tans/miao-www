---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Button } from "@/components/ui/button";
import { Alert, AlertDescription } from "@/components/ui/alert";
---

<AdminLayout title="资金管理" activeMenu="finance">
  <div class="max-w-[1400px]">
    <h1 class="text-2xl font-semibold mb-6">资金管理</h1>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4" id="stats-container">
      <div class="text-center py-12 text-muted-foreground">加载中...</div>
    </div>

    <Card class="mt-6">
      <CardHeader>
        <CardTitle>交易记录</CardTitle>
      </CardHeader>
      <CardContent class="p-0">
        <div id="transactions-container">
          <div class="text-center py-12 text-muted-foreground">加载中...</div>
        </div>
        <div class="flex justify-center items-center gap-4 p-4 border-t" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  let currentPage = 1;

  async function loadFinance(page = 1) {
    const statsContainer = document.getElementById("stats-container");
    const txContainer = document.getElementById("transactions-container");
    const paginationEl = document.getElementById("pagination");
    if (!statsContainer || !txContainer || !paginationEl) return;

    try {
      const [statsRes, txRes] = await Promise.all([
        api.getFinanceStats(),
        api.getFinanceTransactions({ page, page_size: 20 })
      ]);

      // Stats
      if (statsRes.code === 0) {
        const stats = statsRes.data;
        statsContainer.innerHTML = `
          <Card>
            <CardHeader class="pb-2">
              <CardTitle class="text-sm font-normal text-muted-foreground">总收入</CardTitle>
            </CardHeader>
            <CardContent>
              <div class="text-2xl font-bold text-green-600">¥${(stats.total_revenue || 0).toFixed(2)}</div>
            </CardContent>
          </Card>

          <Card>
            <CardHeader class="pb-2">
              <CardTitle class="text-sm font-normal text-muted-foreground">今日收入</CardTitle>
            </CardHeader>
            <CardContent>
              <div class="text-2xl font-bold text-green-600">¥${(stats.today_revenue || 0).toFixed(2)}</div>
            </CardContent>
          </Card>

          <Card>
            <CardHeader class="pb-2">
              <CardTitle class="text-sm font-normal text-muted-foreground">总交易笔数</CardTitle>
            </CardHeader>
            <CardContent>
              <div class="text-2xl font-bold">${stats.total_transactions || 0}</div>
              <p class="text-xs text-muted-foreground">笔</p>
            </CardContent>
          </Card>
        `;
      }

      // Transactions
      if (txRes.code === 0) {
        const transactions = txRes.data.transactions || [];
        const total = txRes.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (transactions.length === 0) {
          txContainer.innerHTML = `
            <Alert class="m-4">
              <AlertDescription>暂无数据</AlertDescription>
            </Alert>
          `;
          paginationEl.innerHTML = "";
          return;
        }

        txContainer.innerHTML = `
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>ID</TableHead>
                <TableHead>用户ID</TableHead>
                <TableHead>类型</TableHead>
                <TableHead>金额</TableHead>
                <TableHead>余额变化</TableHead>
                <TableHead>备注</TableHead>
                <TableHead>时间</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              ${transactions.map((tx: any) => `
                <TableRow>
                  <TableCell class="font-mono text-xs">${tx.id}</TableCell>
                  <TableCell class="font-mono text-xs">${tx.user_id}</TableCell>
                  <TableCell>${tx.type}</TableCell>
                  <TableCell class="font-mono">
                    <span class="${tx.amount >= 0 ? 'text-green-600' : 'text-red-600'}">
                      ${tx.amount >= 0 ? "+" : ""}¥${(tx.amount || 0).toFixed(2)}
                    </span>
                  </TableCell>
                  <TableCell class="font-mono text-muted-foreground text-xs">
                    ${(tx.balance_before || 0).toFixed(2)} → ${(tx.balance_after || 0).toFixed(2)}
                  </TableCell>
                  <TableCell class="text-muted-foreground text-xs">${tx.remark || "-"}</TableCell>
                  <TableCell class="text-muted-foreground text-xs">${new Date(tx.created_at).toLocaleString("zh-CN")}</TableCell>
                </TableRow>
              `).join("")}
            </TableBody>
          </Table>
        `;

        if (totalPages > 1) {
          paginationEl.innerHTML = `
            <Button variant="outline" size="sm" ${page <= 1 ? 'disabled' : ''} data-page="${page - 1}">上一页</Button>
            <span class="text-sm text-muted-foreground">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
            <Button variant="outline" size="sm" ${page >= totalPages ? 'disabled' : ''} data-page="${page + 1}">下一页</Button>
          `;
        } else {
          paginationEl.innerHTML = "";
        }
      }
    } catch (e) {
      statsContainer.innerHTML = `
        <Alert variant="destructive" class="col-span-full">
          <AlertDescription>加载失败</AlertDescription>
        </Alert>
      `;
      txContainer.innerHTML = `
        <Alert variant="destructive" class="m-4">
          <AlertDescription>加载失败</AlertDescription>
        </Alert>
      `;
    }
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest("button[data-page]");
    if (btn && !btn.hasAttribute("disabled")) {
      currentPage = parseInt(btn.getAttribute("data-page") || "1");
      loadFinance(currentPage);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadFinance();
  }
</script>
