---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
---

<AdminLayout title="资金管理" activeMenu="finance">
  <div class="finance-page">
    <h1 class="page-title">资金管理</h1>

    <div id="stats-container">
      <div class="loading">加载中...</div>
    </div>

    <Card class="mt-6">
      <CardHeader>
        <CardTitle>交易记录</CardTitle>
      </CardHeader>
      <CardContent class="p-0">
        <div id="transactions-container">
          <div class="loading">加载中...</div>
        </div>
        <div class="pagination" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  let currentPage = 1;

  async function loadFinance(page = 1) {
    const statsContainer = document.getElementById("stats-container");
    const txContainer = document.getElementById("transactions-container");
    const paginationEl = document.getElementById("pagination");
    if (!statsContainer || !txContainer || !paginationEl) return;

    try {
      const [statsRes, txRes] = await Promise.all([
        api.getFinanceStats(),
        api.getFinanceTransactions({ page, page_size: 20 })
      ]);

      // Stats
      if (statsRes.code === 0) {
        const stats = statsRes.data;
        statsContainer.innerHTML = `
          <div class="stats-grid">
            <Card>
              <CardHeader class="pb-2">
                <CardTitle class="text-sm font-normal text-muted-foreground">总收入</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="text-2xl font-bold text-green-600">¥${(stats.total_revenue || 0).toFixed(2)}</div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader class="pb-2">
                <CardTitle class="text-sm font-normal text-muted-foreground">今日收入</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="text-2xl font-bold text-green-600">¥${(stats.today_revenue || 0).toFixed(2)}</div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader class="pb-2">
                <CardTitle class="text-sm font-normal text-muted-foreground">总交易笔数</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="text-2xl font-bold">${stats.total_transactions || 0}</div>
                <p class="text-xs text-muted-foreground">笔</p>
              </CardContent>
            </Card>
          </div>
        `;
      }

      // Transactions
      if (txRes.code === 0) {
        const transactions = txRes.data.transactions || [];
        const total = txRes.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (transactions.length === 0) {
          txContainer.innerHTML = `<div class="empty-state">暂无数据</div>`;
          paginationEl.innerHTML = "";
          return;
        }

        txContainer.innerHTML = `
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>ID</TableHead>
                <TableHead>用户ID</TableHead>
                <TableHead>类型</TableHead>
                <TableHead>金额</TableHead>
                <TableHead>余额变化</TableHead>
                <TableHead>备注</TableHead>
                <TableHead>时间</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              ${transactions.map((tx: any) => `
                <TableRow>
                  <TableCell class="font-mono text-xs">${tx.id}</TableCell>
                  <TableCell class="font-mono text-xs">${tx.user_id}</TableCell>
                  <TableCell>${tx.type}</TableCell>
                  <TableCell class="font-mono">
                    <span class="${tx.amount >= 0 ? 'text-green-600' : 'text-red-600'}">
                      ${tx.amount >= 0 ? "+" : ""}¥${(tx.amount || 0).toFixed(2)}
                    </span>
                  </TableCell>
                  <TableCell class="font-mono text-muted-foreground text-xs">
                    ${(tx.balance_before || 0).toFixed(2)} → ${(tx.balance_after || 0).toFixed(2)}
                  </TableCell>
                  <TableCell class="text-muted-foreground text-xs">${tx.remark || "-"}</TableCell>
                  <TableCell class="text-muted-foreground text-xs">${new Date(tx.created_at).toLocaleString("zh-CN")}</TableCell>
                </TableRow>
              `).join("")}
            </TableBody>
          </Table>
        `;

        paginationEl.innerHTML = totalPages > 1 ? `
          <a href="#" class="page-btn ${page <= 1 ? 'disabled' : ''}" data-page="${page - 1}">上一页</a>
          <span class="page-info">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
          <a href="#" class="page-btn ${page >= totalPages ? 'disabled' : ''}" data-page="${page + 1}">下一页</a>
        ` : "";
      }
    } catch (e) {
      statsContainer.innerHTML = `<div class="error-message">加载失败</div>`;
      txContainer.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("page-btn") && !target.classList.contains("disabled")) {
      e.preventDefault();
      currentPage = parseInt(target.dataset.page || "1");
      loadFinance(currentPage);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  });

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadFinance();
  }
</script>

<style>
  .finance-page {
    max-width: 1400px;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .loading, .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--admin-text-muted);
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
    margin: 1rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-top: 1px solid var(--admin-border);
  }

  .page-btn {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--admin-text);
    text-decoration: none;
    border: 1px solid var(--admin-border);
    border-radius: 0.375rem;
  }

  .page-btn:hover:not(.disabled) {
    border-color: var(--admin-primary);
    color: var(--admin-primary);
  }

  .page-btn.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .page-info {
    font-size: 0.875rem;
    color: var(--admin-text-muted);
  }
</style>
