---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
---

<AdminLayout title="任务管理" activeMenu="tasks">
  <div class="tasks-page">
    <div class="page-header">
      <h1 class="page-title">任务管理</h1>
      <div class="filter-tabs" id="filter-tabs">
        <a href="#" class="filter-tab active" data-status="">全部</a>
        <a href="#" class="filter-tab" data-status="1">待审核</a>
        <a href="#" class="filter-tab" data-status="2">已上架</a>
        <a href="#" class="filter-tab" data-status="3">进行中</a>
        <a href="#" class="filter-tab" data-status="4">已结束</a>
      </div>
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="tasks-container">
          <div class="loading">加载中...</div>
        </div>
        <div class="pagination" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  let currentPage = 1;
  let currentStatus = "";

  const statusMap: Record<number, { label: string; class: string }> = {
    1: { label: "待审核", class: "bg-yellow-100 text-yellow-800" },
    2: { label: "已上架", class: "bg-green-100 text-green-800" },
    3: { label: "进行中", class: "bg-blue-100 text-blue-800" },
    4: { label: "已结束", class: "bg-gray-100 text-gray-800" },
    5: { label: "已取消", class: "bg-red-100 text-red-800" },
  };

  async function loadTasks(page = 1, status = "") {
    const container = document.getElementById("tasks-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    try {
      const params: any = { page, page_size: 20 };
      if (status) params.status = parseInt(status);
      const res = await api.getTasks(params);

      if (res.code === 0) {
        const tasks = res.data.tasks || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (tasks.length === 0) {
          container.innerHTML = `<div class="empty-state">暂无数据</div>`;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>标题</th>
                <th>单价</th>
                <th>预算/剩余</th>
                <th>已认领/已提交</th>
                <th>状态</th>
                <th>创建时间</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              ${tasks.map((task: any) => `
                <tr>
                  <td class="font-mono text-sm">${task.id}</td>
                  <td class="font-medium max-w-xs truncate">${task.title}</td>
                  <td class="font-mono">¥${(task.unit_price || 0).toFixed(2)}</td>
                  <td><span class="font-mono">${task.total_budget}</span> / <span class="text-muted">${task.remaining_count}</span></td>
                  <td><span class="font-mono">${task.claimed_count || 0}</span> / <span class="text-muted">${task.submitted_count || 0}</span></td>
                  <td><span class="badge ${statusMap[task.status]?.class || "bg-gray-100"}">${statusMap[task.status]?.label || "未知"}</span></td>
                  <td class="text-muted text-sm">${new Date(task.created_at).toLocaleDateString("zh-CN")}</td>
                  <td>
                    <div class="action-buttons">
                      <a href="/admin/task-detail?id=${task.id}" class="action-link">详情</a>
                      ${task.status === 1 ? `<button class="action-link text-green-600" data-action="review" data-id="${task.id}">审核</button>` : ""}
                    </div>
                  </td>
                </tr>
              `).join("")}
            </tbody>
          </table>
        `;

        const statusParam = status ? `&status=${status}` : "";
        paginationEl.innerHTML = totalPages > 1 ? `
          <a href="#" class="page-btn ${page <= 1 ? 'disabled' : ''}" data-page="${page - 1}${statusParam}">上一页</a>
          <span class="page-info">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
          <a href="#" class="page-btn ${page >= totalPages ? 'disabled' : ''}" data-page="${page + 1}${statusParam}">下一页</a>
        ` : "";
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  // Filter tabs handler
  document.getElementById("filter-tabs")?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("filter-tab")) {
      e.preventDefault();
      document.querySelectorAll(".filter-tab").forEach(el => el.classList.remove("active"));
      target.classList.add("active");
      currentStatus = target.dataset.status || "";
      currentPage = 1;
      loadTasks(1, currentStatus);
    }
  });

  // Pagination handler
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("page-btn") && !target.classList.contains("disabled")) {
      e.preventDefault();
      const pageBtn = target;
      const pageMatch = pageBtn.dataset.page?.match(/^(\d+)(.*)$/);
      if (pageMatch) {
        currentPage = parseInt(pageMatch[1]);
        const newStatus = pageMatch[2]?.replace("&status=", "") || currentStatus;
        loadTasks(currentPage, newStatus);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    }
  });

  // Initial load
  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadTasks();
  }
</script>

<style>
  .tasks-page {
    max-width: 1400px;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .filter-tabs {
    display: flex;
    gap: 0.25rem;
    background: white;
    padding: 0.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
  }

  .filter-tab {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: all 0.2s;
  }

  .filter-tab:hover {
    color: var(--text);
    background: var(--bg);
  }

  .filter-tab.active {
    background: var(--primary);
    color: white;
  }

  .loading, .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--text-muted);
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
    margin: 1rem;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
  }

  .data-table th,
  .data-table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .data-table th {
    background: #fafafa;
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .data-table td {
    font-size: 0.875rem;
  }

  .badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .action-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .action-link {
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    color: var(--primary);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 0.375rem;
  }

  .action-link:hover {
    background: rgba(233, 69, 96, 0.1);
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-top: 1px solid var(--border);
  }

  .page-btn {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
  }

  .page-btn:hover:not(.disabled) {
    border-color: var(--primary);
    color: var(--primary);
  }

  .page-btn.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .page-info {
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
