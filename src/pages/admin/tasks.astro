---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import { FilterTabs } from "@/components/FilterTabs";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Alert, AlertDescription } from "@/components/ui/alert";
---

<AdminLayout title="任务管理" activeMenu="tasks">
  <div class="max-w-[1400px]">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-semibold">任务管理</h1>
      <div class="flex items-center gap-3">
        <Input type="search" placeholder="搜索任务ID/标题..." class="w-64" id="search-input" />
        <FilterTabs
          client:only="react"
          options={[
            { value: "", label: "全部" },
            { value: "1", label: "待审核" },
            { value: "2", label: "已上架" },
            { value: "3", label: "进行中" },
            { value: "5", label: "已结束" },
          ]}
          id="filter-tabs"
          className="mb-0"
          eventName="filter-tabs-change"
        />
      </div>
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="tasks-container">
          <div class="text-center py-12 text-muted-foreground">加载中...</div>
        </div>
        <div class="flex justify-center items-center gap-4 p-4 border-t" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";
  import { toast } from "sonner";

  let currentPage = 1;
  let currentStatus = "";
  let searchKeyword = "";
  let debounceTimer: ReturnType<typeof setTimeout>;

  const statusMap: Record<string, { label: string; variant: "default" | "secondary" | "outline" | "destructive" }> = {
    "1": { label: "待审核", variant: "secondary" },
    "2": { label: "已上架", variant: "default" },
    "3": { label: "进行中", variant: "default" },
    "4": { label: "已结束", variant: "outline" },
    "5": { label: "已取消", variant: "destructive" },
  };

  async function loadTasks(page = 1, status = "") {
    const container = document.getElementById("tasks-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    container.innerHTML = `<div class="text-center py-12 text-muted-foreground">加载中...</div>`;

    try {
      const params: any = { page, page_size: 20 };
      if (status) params.status = status;
      if (searchKeyword) params.keyword = searchKeyword;

      const res = await api.getTasks(params);

      if (res.code === 0) {
        const tasks = res.data.tasks || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (tasks.length === 0) {
          container.innerHTML = `
            <Alert class="m-4">
              <AlertDescription>暂无数据${searchKeyword || status ? "，请调整筛选条件" : ""}</AlertDescription>
            </Alert>
          `;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>ID</TableHead>
                <TableHead>标题</TableHead>
                <TableHead>商家ID</TableHead>
                <TableHead>单价</TableHead>
                <TableHead>预算/剩余</TableHead>
                <TableHead>已认领/已提交</TableHead>
                <TableHead>状态</TableHead>
                <TableHead>创建时间</TableHead>
                <TableHead>操作</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              ${tasks.map((task: any) => `
                <TableRow>
                  <TableCell class="font-mono text-xs">${task.id}</TableCell>
                  <TableCell class="font-medium max-w-64 truncate">${task.title}</TableCell>
                  <TableCell class="font-mono text-xs">${task.business_id}</TableCell>
                  <TableCell class="font-mono">¥${(task.unit_price || 0).toFixed(2)}</TableCell>
                  <TableCell>
                    <span class="font-mono">${task.total_budget}</span> / <span class="text-muted-foreground">${task.remaining_count}</span>
                  </TableCell>
                  <TableCell>
                    <span class="font-mono">${task.claimed_count || 0}</span> / <span class="text-muted-foreground">${task.submitted_count || 0}</span>
                  </TableCell>
                  <TableCell>
                    <Badge variant="${statusMap[task.status]?.variant || "secondary"}">${statusMap[task.status]?.label || "未知"}</Badge>
                  </TableCell>
                  <TableCell class="text-muted-foreground text-xs">${new Date(task.created_at).toLocaleDateString("zh-CN")}</TableCell>
                  <TableCell>
                    <div class="flex gap-2">
                      <a href="/admin/task-detail?id=${task.id}" class="text-primary hover:underline text-sm">详情</a>
                      ${task.status === 1 ? `
                        <button class="text-green-600 hover:underline text-sm" data-action="review" data-id="${task.id}" data-result="approve">通过</button>
                        <button class="text-red-600 hover:underline text-sm" data-action="review" data-id="${task.id}" data-result="reject">拒绝</button>
                      ` : ""}
                    </div>
                  </TableCell>
                </TableRow>
              `).join("")}
            </TableBody>
          </Table>
        `;

        if (totalPages > 1) {
          const statusParam = status ? `&status=${status}` : "";
          paginationEl.innerHTML = `
            <Button variant="outline" size="sm" ${page <= 1 ? "disabled" : ""} data-page="${page - 1}${statusParam}">上一页</Button>
            <span class="text-sm text-muted-foreground">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
            <Button variant="outline" size="sm" ${page >= totalPages ? "disabled" : ""} data-page="${page + 1}${statusParam}">下一页</Button>
          `;
        } else {
          paginationEl.innerHTML = "";
        }
      } else {
        container.innerHTML = `
          <Alert variant="destructive" class="m-4">
            <AlertDescription>${res.message}</AlertDescription>
          </Alert>
        `;
        paginationEl.innerHTML = "";
      }
    } catch (e) {
      container.innerHTML = `
        <Alert variant="destructive" class="m-4">
          <AlertDescription>加载失败</AlertDescription>
        </Alert>
      `;
      paginationEl.innerHTML = "";
    }
  }

  // Search with debounce
  document.getElementById("search-input")?.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      searchKeyword = target.value.trim();
      currentPage = 1;
      loadTasks(1, currentStatus);
    }, 300);
  });

  // Filter tabs handler
  window.addEventListener("filter-tabs-change", (e: Event) => {
    const customEvent = e as CustomEvent<{ value: string }>
    currentStatus = customEvent.detail.value
    currentPage = 1
    loadTasks(1, currentStatus)
  })

  // Pagination handler
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest("button[data-page]");
    if (btn && !btn.hasAttribute("disabled")) {
      const pageBtn = btn as HTMLElement;
      const pageMatch = pageBtn.dataset.page?.match(/^(\d+)(.*)$/);
      if (pageMatch) {
        currentPage = parseInt(pageMatch[1]);
        const newStatus = pageMatch[2]?.replace("&status=", "") || currentStatus;
        loadTasks(currentPage, newStatus);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    }
  });

  // Review action handler (approve/reject)
  document.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement;
    const action = target.dataset.action;
    const id = target.dataset.id;
    const result = target.dataset.result;
    if (action !== "review" || !id || !result) return;

    const approved = result === "approve";
    const actionText = approved ? "通过" : "拒绝";
    if (!confirm(`确定${actionText}该任务？`)) return;

    try {
      const res = await api.reviewTask(parseInt(id), approved);
      if (res.code === 0) {
        toast.success(`已${actionText}`);
        loadTasks(currentPage, currentStatus);
      } else {
        toast.error("操作失败: " + res.message);
      }
    } catch (e) {
      toast.error("操作失败");
    }
  });

  // Initial load
  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadTasks();
  }
</script>
