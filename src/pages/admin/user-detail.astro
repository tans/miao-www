---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Input } from "@/components/ui/input";
---

<AdminLayout title="用户详情" activeMenu="users">
  <div class="user-detail-page">
    <div class="page-header">
      <a href="/admin/users" class="back-link">← 返回列表</a>
      <h1 class="page-title">用户详情</h1>
    </div>

    <div id="user-container">
      <div class="loading">加载中...</div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";
  import { toast } from "sonner";

  const urlParams = new URLSearchParams(window.location.search);
  const userId = urlParams.get("id");

  if (!userId) {
    document.getElementById("user-container")!.innerHTML = `<div class="error-message">缺少用户ID参数</div>`;
  }

  const statusMap: Record<number, { label: string; variant: string }> = {
    1: { label: "正常", variant: "default" },
    2: { label: "禁用", variant: "destructive" },
    3: { label: "冻结", variant: "secondary" },
  };

  const roleMap: Record<number, string> = {
    1: "创作者",
    2: "商家",
    3: "管理员",
  };

  async function loadUser() {
    const container = document.getElementById("user-container");
    if (!container || !userId) return;

    try {
      const res = await api.getUserDetail(parseInt(userId));
      if (res.code === 0) {
        const user = res.data.user;
        container.innerHTML = `
          <div class="detail-grid">
            <Card>
              <CardHeader>
                <CardTitle>基本信息</CardTitle>
              </CardHeader>
              <CardContent class="space-y-3">
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">用户ID</span>
                  <span class="font-mono text-sm">${user.id}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">用户名</span>
                  <span class="font-medium">${user.username}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">邮箱</span>
                  <span class="text-sm">${user.email || "-"}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">手机号</span>
                  <span class="text-sm">${user.phone || "-"}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">角色</span>
                  <Badge variant="outline">${roleMap[user.role] || "未知"}</Badge>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">等级</span>
                  <span class="text-sm">${user.level || "-"}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">状态</span>
                  <Badge variant="${statusMap[user.status]?.variant || "secondary"}">${statusMap[user.status]?.label || "未知"}</Badge>
                </div>
                <div class="flex justify-between py-2">
                  <span class="text-muted-foreground text-sm">注册时间</span>
                  <span class="text-sm">${new Date(user.created_at).toLocaleString("zh-CN")}</span>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle>财务信息</CardTitle>
              </CardHeader>
              <CardContent class="space-y-3">
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">余额</span>
                  <span class="font-mono text-lg text-green-600">¥${(user.balance || 0).toFixed(2)}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">冻结金额</span>
                  <span class="font-mono">¥${(user.margin_frozen || 0).toFixed(2)}</span>
                </div>
                <div class="flex justify-between py-2">
                  <span class="text-muted-foreground text-sm">信用评分</span>
                  <span class="text-sm">${user.credit_score || 0}</span>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle>操作</CardTitle>
              </CardHeader>
              <CardContent class="space-y-4">
                <div class="flex items-center gap-3">
                  <label class="text-sm text-muted-foreground w-20">修改状态</label>
                  <select id="status-select" class="flex h-8 rounded-lg border border-input bg-transparent px-3 py-1 text-sm w-32">
                    <option value="1" ${user.status === 1 ? "selected" : ""}>正常</option>
                    <option value="2" ${user.status === 2 ? "selected" : ""}>禁用</option>
                    <option value="3" ${user.status === 3 ? "selected" : ""}>冻结</option>
                  </select>
                  <Button size="sm" id="update-status-btn">更新状态</Button>
                </div>
                <div class="flex items-center gap-3">
                  <label class="text-sm text-muted-foreground w-20">调整余额</label>
                  <Input type="number" id="balance-input" class="w-32" value="${user.balance || 0}" step="0.01" />
                  <Button size="sm" id="update-balance-btn">调整余额</Button>
                </div>
              </CardContent>
            </Card>
          </div>

          <Card class="mt-6">
            <CardHeader>
              <CardTitle>交易记录</CardTitle>
            </CardHeader>
            <CardContent class="p-0">
              <div id="transactions-container">
                <div class="loading-sm">加载中...</div>
              </div>
            </CardContent>
          </Card>
        `;

        document.getElementById("update-status-btn")?.addEventListener("click", async () => {
          const status = parseInt((document.getElementById("status-select") as HTMLSelectElement).value);
          try {
            const res = await api.updateUserStatus(parseInt(userId), status);
            if (res.code === 0) {
              toast.success("状态已更新");
              loadUser();
            } else {
              toast.error("更新失败: " + res.message);
            }
          } catch (e) {
            toast.error("更新失败");
          }
        });

        document.getElementById("update-balance-btn")?.addEventListener("click", async () => {
          const balance = parseFloat((document.getElementById("balance-input") as HTMLInputElement).value);
          try {
            const res = await api.updateUserBalance(parseInt(userId), balance);
            if (res.code === 0) {
              toast.success("余额已更新");
              loadUser();
            } else {
              toast.error("更新失败: " + res.message);
            }
          } catch (e) {
            toast.error("更新失败");
          }
        });

        loadTransactions();
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  async function loadTransactions() {
    const container = document.getElementById("transactions-container");
    if (!container || !userId) return;

    try {
      const res = await api.request<{ transactions: any[] }>(`/api/v1/admin/users/${userId}/transactions`);
      if (res.code === 0) {
        const txs = res.data.transactions || [];
        if (txs.length === 0) {
          container.innerHTML = `<div class="empty-state">暂无交易记录</div>`;
          return;
        }
        container.innerHTML = `
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>ID</TableHead>
                <TableHead>类型</TableHead>
                <TableHead>金额</TableHead>
                <TableHead>余额</TableHead>
                <TableHead>备注</TableHead>
                <TableHead>时间</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              ${txs.map((tx: any) => `
                <TableRow>
                  <TableCell class="font-mono text-xs">${tx.id}</TableCell>
                  <TableCell>${tx.type}</TableCell>
                  <TableCell class="font-mono ${tx.amount >= 0 ? "text-green-600" : "text-red-600"}">${tx.amount >= 0 ? "+" : ""}¥${(tx.amount || 0).toFixed(2)}</TableCell>
                  <TableCell class="font-mono">¥${(tx.balance_after || 0).toFixed(2)}</TableCell>
                  <TableCell class="text-muted-foreground text-xs">${tx.remark || "-"}</TableCell>
                  <TableCell class="text-muted-foreground text-xs">${new Date(tx.created_at).toLocaleString("zh-CN")}</TableCell>
                </TableRow>
              `).join("")}
            </TableBody>
          </Table>
        `;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载交易记录失败</div>`;
    }
  }

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadUser();
  }
</script>

<style>
  .user-detail-page {
    max-width: 1200px;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .back-link {
    color: var(--admin-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  .back-link:hover {
    color: var(--admin-primary);
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .loading, .loading-sm, .empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--admin-text-muted);
  }

  .loading-sm {
    padding: 1rem;
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .space-y-3 > * + * {
    margin-top: 0.75rem;
  }

  .space-y-4 > * + * {
    margin-top: 1rem;
  }

  .py-2 {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .border-b {
    border-bottom: 1px solid var(--admin-border);
  }

  .flex {
    display: flex;
  }

  .justify-between {
    justify-content: space-between;
  }

  .items-center {
    align-items: center;
  }

  .gap-3 {
    gap: 0.75rem;
  }

  .w-20 {
    width: 5rem;
  }

  .w-32 {
    width: 8rem;
  }

  .mt-6 {
    margin-top: 1.5rem;
  }
</style>
