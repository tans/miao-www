---

import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
---

<AdminLayout title="用户详情" activeMenu="users">
  <div class="user-detail-page">
    <div class="page-header">
      <a href="/admin/users" class="back-link">← 返回列表</a>
      <h1 class="page-title">用户详情</h1>
    </div>

    <div id="user-container">
      <div class="loading">加载中...</div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  const urlParams = new URLSearchParams(window.location.search);
  const userId = urlParams.get("id");

  if (!userId) {
    document.getElementById("user-container")!.innerHTML = `<div class="error-message">缺少用户ID参数</div>`;
  }

  const statusMap: Record<number, { label: string; class: string }> = {
    1: { label: "正常", class: "bg-green-100 text-green-800" },
    2: { label: "禁用", class: "bg-red-100 text-red-800" },
    3: { label: "冻结", class: "bg-yellow-100 text-yellow-800" },
  };

  const roleMap: Record<number, string> = {
    1: "创作者",
    2: "商家",
    3: "管理员",
  };

  async function loadUser() {
    const container = document.getElementById("user-container");
    if (!container || !userId) return;

    try {
      const res = await api.getUserDetail(parseInt(userId));
      if (res.code === 0) {
        const user = res.data.user;
        container.innerHTML = `
          <div class="detail-grid">
            <Card>
              <CardHeader>
                <CardTitle>基本信息</CardTitle>
              </CardHeader>
              <CardContent class="info-list">
                <div class="info-item">
                  <span class="info-label">用户ID</span>
                  <span class="info-value font-mono">${user.id}</span>
                </div>
                <div class="info-item">
                  <span class="info-label">用户名</span>
                  <span class="info-value">${user.username}</span>
                </div>
                <div class="info-item">
                  <span class="info-label">邮箱</span>
                  <span class="info-value">${user.email || "-"}</span>
                </div>
                <div class="info-item">
                  <span class="info-label">手机号</span>
                  <span class="info-value">${user.phone || "-"}</span>
                </div>
                <div class="info-item">
                  <span class="info-label">角色</span>
                  <span class="info-value"><span class="badge-outline">${roleMap[user.role] || "未知"}</span></span>
                </div>
                <div class="info-item">
                  <span class="info-label">等级</span>
                  <span class="info-value">${user.level || "-"}</span>
                </div>
                <div class="info-item">
                  <span class="info-label">状态</span>
                  <span class="info-value"><span class="badge ${statusMap[user.status]?.class || "bg-gray-100"}">${statusMap[user.status]?.label || "未知"}</span></span>
                </div>
                <div class="info-item">
                  <span class="info-label">注册时间</span>
                  <span class="info-value">${new Date(user.created_at).toLocaleString("zh-CN")}</span>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle>财务信息</CardTitle>
              </CardHeader>
              <CardContent class="info-list">
                <div class="info-item">
                  <span class="info-label">余额</span>
                  <span class="info-value font-mono text-lg text-green-600">¥${(user.balance || 0).toFixed(2)}</span>
                </div>
                <div class="info-item">
                  <span class="info-label">冻结金额</span>
                  <span class="info-value font-mono">¥${(user.margin_frozen || 0).toFixed(2)}</span>
                </div>
                <div class="info-item">
                  <span class="info-label">信用评分</span>
                  <span class="info-value">${user.credit_score || 0}</span>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle>操作</CardTitle>
              </CardHeader>
              <CardContent class="actions">
                <div class="action-group">
                  <label>修改状态</label>
                  <select id="status-select" class="select-input">
                    <option value="1" ${user.status === 1 ? "selected" : ""}>正常</option>
                    <option value="2" ${user.status === 2 ? "selected" : ""}>禁用</option>
                    <option value="3" ${user.status === 3 ? "selected" : ""}>冻结</option>
                  </select>
                  <button class="btn btn-primary" id="update-status-btn">更新状态</button>
                </div>
                <div class="action-group">
                  <label>调整余额</label>
                  <input type="number" id="balance-input" class="input" value="${user.balance || 0}" step="0.01">
                  <button class="btn btn-primary" id="update-balance-btn">调整余额</button>
                </div>
              </CardContent>
            </Card>
          </div>

          <Card class="mt-6">
            <CardHeader>
              <CardTitle>交易记录</CardTitle>
            </CardHeader>
            <CardContent class="p-0">
              <div id="transactions-container">
                <div class="loading-sm">加载中...</div>
              </div>
            </CardContent>
          </Card>
        `;

        document.getElementById("update-status-btn")?.addEventListener("click", async () => {
          const status = parseInt((document.getElementById("status-select") as HTMLSelectElement).value);
          try {
            const res = await api.updateUserStatus(parseInt(userId), status);
            if (res.code === 0) {
              alert("状态已更新");
              loadUser();
            } else {
              alert("更新失败: " + res.message);
            }
          } catch (e) {
            alert("更新失败");
          }
        });

        document.getElementById("update-balance-btn")?.addEventListener("click", async () => {
          const balance = parseFloat((document.getElementById("balance-input") as HTMLInputElement).value);
          try {
            const res = await api.updateUserBalance(parseInt(userId), balance);
            if (res.code === 0) {
              alert("余额已更新");
              loadUser();
            } else {
              alert("更新失败: " + res.message);
            }
          } catch (e) {
            alert("更新失败");
          }
        });

        loadTransactions();
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  async function loadTransactions() {
    const container = document.getElementById("transactions-container");
    if (!container || !userId) return;

    try {
      const res = await api.request<{ transactions: any[] }>(`/api/v1/admin/users/${userId}/transactions`);
      if (res.code === 0) {
        const txs = res.data.transactions || [];
        if (txs.length === 0) {
          container.innerHTML = `<div class="empty-state">暂无交易记录</div>`;
          return;
        }
        container.innerHTML = `
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>类型</th>
                <th>金额</th>
                <th>余额</th>
                <th>备注</th>
                <th>时间</th>
              </tr>
            </thead>
            <tbody>
              ${txs.map((tx: any) => `
                <tr>
                  <td class="font-mono">${tx.id}</td>
                  <td>${tx.type}</td>
                  <td class="font-mono ${tx.amount >= 0 ? "text-green-600" : "text-red-600"}">${tx.amount >= 0 ? "+" : ""}¥${(tx.amount || 0).toFixed(2)}</td>
                  <td class="font-mono">¥${(tx.balance_after || 0).toFixed(2)}</td>
                  <td class="text-muted">${tx.remark || "-"}</td>
                  <td class="text-muted">${new Date(tx.created_at).toLocaleString("zh-CN")}</td>
                </tr>
              `).join("")}
            </tbody>
          </table>
        `;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载交易记录失败</div>`;
    }
  }

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadUser();
  }
</script>

<style>
  .user-detail-page {
    max-width: 1200px;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  .back-link:hover {
    color: var(--primary);
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .loading, .loading-sm, .empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--text-muted);
  }

  .loading-sm {
    padding: 1rem;
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  :global(.info-list) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .info-item:last-child {
    border-bottom: none;
  }

  .info-label {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .info-value {
    font-weight: 500;
  }

  .badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .badge-outline {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    font-size: 0.75rem;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .action-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .action-group label {
    font-size: 0.875rem;
    color: var(--text-muted);
    min-width: 60px;
  }

  .select-input, .input {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    font-size: 0.875rem;
  }

  .select-input {
    min-width: 100px;
  }

  .input {
    width: 120px;
  }

  .btn {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--primary);
    color: white;
  }

  .btn-primary:hover {
    background: var(--primary-hover);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
  }

  .data-table th,
  .data-table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  .data-table th {
    background: #fafafa;
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .data-table td {
    font-size: 0.875rem;
  }
</style>
