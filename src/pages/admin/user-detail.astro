---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { UserDetail } from "@/components/admin/UserDetail";
---

<AdminLayout title="用户详情" activeMenu="users">
  <div class="max-w-[1200px]">
    <div class="mb-6">
      <a href="/admin/users" class="text-muted-foreground hover:text-primary text-sm mb-2 inline-block">← 返回列表</a>
      <h1 class="text-2xl font-semibold">用户详情</h1>
    </div>

    <div id="user-container">
      <UserDetail client:load userId={new URLSearchParams(Astro.url.search).get("id") || ""} />
    </div>
  </div>
</AdminLayout>