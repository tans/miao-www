---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Input } from "@/components/ui/input";
---

<AdminLayout title="任务详情" activeMenu="tasks">
  <div class="task-detail-page">
    <div class="page-header">
      <a href="/admin/tasks" class="back-link">← 返回列表</a>
      <h1 class="page-title">任务详情</h1>
    </div>

    <div id="task-container">
      <div class="loading">加载中...</div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";
  import { toast } from "sonner";

  const urlParams = new URLSearchParams(window.location.search);
  const taskId = urlParams.get("id");

  if (!taskId) {
    document.getElementById("task-container")!.innerHTML = `<div class="error-message">缺少任务ID参数</div>`;
  }

  const statusMap: Record<number, { label: string; variant: string }> = {
    1: { label: "待审核", variant: "secondary" },
    2: { label: "已上架", variant: "default" },
    3: { label: "进行中", variant: "default" },
    4: { label: "已结束", variant: "outline" },
    5: { label: "已取消", variant: "destructive" },
  };

  async function loadTask() {
    const container = document.getElementById("task-container");
    if (!container || !taskId) return;

    try {
      const res = await api.getTaskDetail(parseInt(taskId));
      if (res.code === 0) {
        const task = res.data.task;
        container.innerHTML = `
          <div class="detail-grid">
            <Card class="col-span-2">
              <CardHeader>
                <CardTitle>基本信息</CardTitle>
              </CardHeader>
              <CardContent class="space-y-3">
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">任务ID</span>
                  <span class="font-mono text-sm">${task.id}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">标题</span>
                  <span class="font-medium">${task.title}</span>
                </div>
                <div class="py-2 border-b">
                  <span class="text-muted-foreground text-sm block mb-1">描述</span>
                  <span class="text-sm whitespace-pre-wrap">${task.description || "-"}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">商家ID</span>
                  <span class="font-mono text-sm">${task.business_id}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">状态</span>
                  <Badge variant="${statusMap[task.status]?.variant || "secondary"}">${statusMap[task.status]?.label || "未知"}</Badge>
                </div>
                <div class="flex justify-between py-2">
                  <span class="text-muted-foreground text-sm">创建时间</span>
                  <span class="text-sm">${new Date(task.created_at).toLocaleString("zh-CN")}</span>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle>价格与预算</CardTitle>
              </CardHeader>
              <CardContent class="space-y-3">
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">单价</span>
                  <span class="font-mono text-lg text-green-600">¥${(task.unit_price || 0).toFixed(2)}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">总预算</span>
                  <span class="font-mono">¥${(task.total_budget || 0).toFixed(2)}</span>
                </div>
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">已支付</span>
                  <span class="font-mono">¥${(task.paid_amount || 0).toFixed(2)}</span>
                </div>
                <div class="flex justify-between py-2">
                  <span class="text-muted-foreground text-sm">剩余数量</span>
                  <span>${task.remaining_count} / ${Math.floor(task.total_budget / task.unit_price)}</span>
                </div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader>
                <CardTitle>进度</CardTitle>
              </CardHeader>
              <CardContent class="space-y-3">
                <div class="flex justify-between py-2 border-b">
                  <span class="text-muted-foreground text-sm">已认领</span>
                  <span>${task.claimed_count || 0}</span>
                </div>
                <div class="flex justify-between py-2">
                  <span class="text-muted-foreground text-sm">已提交</span>
                  <span>${task.submitted_count || 0}</span>
                </div>
              </CardContent>
            </Card>

            ${task.cover_image ? `
            <Card>
              <CardHeader>
                <CardTitle>封面图</CardTitle>
              </CardHeader>
              <CardContent>
                <img src="${task.cover_image}" alt="封面" class="w-full max-w-sm rounded-lg" />
              </CardContent>
            </Card>
            ` : ""}
          </div>

          ${task.status === 1 ? `
          <Card class="mt-6">
            <CardHeader>
              <CardTitle>审核操作</CardTitle>
            </CardHeader>
            <CardContent class="flex gap-3">
              <Button id="approve-btn" class="bg-green-600 hover:bg-green-700">通过审核</Button>
              <Button id="reject-btn" variant="destructive">拒绝</Button>
            </CardContent>
          </Card>
          ` : ""}

          <Card class="mt-6">
            <CardHeader>
              <CardTitle>投稿列表</CardTitle>
            </CardHeader>
            <CardContent class="p-0">
              <div id="claims-container">
                <div class="loading-sm">加载中...</div>
              </div>
            </CardContent>
          </Card>
        `;

        document.getElementById("approve-btn")?.addEventListener("click", async () => {
          if (!confirm("确定通过该任务审核？")) return;
          try {
            const res = await api.reviewTask(parseInt(taskId), 2);
            if (res.code === 0) {
              toast.success("已通过审核");
              loadTask();
            } else {
              toast.error("操作失败: " + res.message);
            }
          } catch (e) {
            toast.error("操作失败");
          }
        });

        document.getElementById("reject-btn")?.addEventListener("click", async () => {
          if (!confirm("确定拒绝该任务？")) return;
          try {
            const res = await api.reviewTask(parseInt(taskId), 5);
            if (res.code === 0) {
              toast.success("已拒绝");
              loadTask();
            } else {
              toast.error("操作失败: " + res.message);
            }
          } catch (e) {
            toast.error("操作失败");
          }
        });

        loadClaims();
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  async function loadClaims() {
    const container = document.getElementById("claims-container");
    if (!container || !taskId) return;

    try {
      const res = await api.request<{ claims: any[] }>(`/api/v1/admin/claims?task_id=${taskId}`);
      if (res.code === 0) {
        const claims = res.data.claims || [];
        if (claims.length === 0) {
          container.innerHTML = `<div class="empty-state">暂无投稿</div>`;
          return;
        }
        container.innerHTML = `
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>ID</TableHead>
                <TableHead>创作者</TableHead>
                <TableHead>状态</TableHead>
                <TableHead>提交时间</TableHead>
                <TableHead>操作</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              ${claims.map((claim: any) => `
                <TableRow>
                  <TableCell class="font-mono text-xs">${claim.id}</TableCell>
                  <TableCell class="font-mono text-xs">${claim.creator_id}</TableCell>
                  <TableCell>
                    <Badge variant="${statusMap[claim.status]?.variant || "secondary"}">${statusMap[claim.status]?.label || "未知"}</Badge>
                  </TableCell>
                  <TableCell class="text-muted-foreground text-xs">${claim.submit_at ? new Date(claim.submit_at).toLocaleString("zh-CN") : "-"}</TableCell>
                  <TableCell>
                    <a href="/admin/work-detail?id=${claim.work_id}" class="text-primary hover:underline text-sm">查看作品</a>
                  </TableCell>
                </TableRow>
              `).join("")}
            </TableBody>
          </Table>
        `;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载投稿失败</div>`;
    }
  }

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadTask();
  }
</script>

<style>
  .task-detail-page {
    max-width: 1200px;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .back-link {
    color: var(--admin-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  .back-link:hover {
    color: var(--admin-primary);
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .loading, .loading-sm, .empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--admin-text-muted);
  }

  .loading-sm {
    padding: 1rem;
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .col-span-2 {
    grid-column: span 2;
  }

  @media (max-width: 768px) {
    .col-span-2 {
      grid-column: span 1;
    }
  }

  .space-y-3 > * + * {
    margin-top: 0.75rem;
  }

  .py-2 {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .border-b {
    border-bottom: 1px solid var(--admin-border);
  }

  .flex {
    display: flex;
  }

  .justify-between {
    justify-content: space-between;
  }

  .items-center {
    align-items: center;
  }

  .block {
    display: block;
  }

  .mb-1 {
    margin-bottom: 0.25rem;
  }

  .whitespace-pre-wrap {
    white-space: pre-wrap;
  }

  .max-w-sm {
    max-width: 16rem;
  }

  .rounded-lg {
    border-radius: 0.5rem;
  }

  .mt-6 {
    margin-top: 1.5rem;
  }

  .gap-3 {
    gap: 0.75rem;
  }
</style>
