---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { TaskDetail } from "@/components/admin/TaskDetail";
---

<AdminLayout title="任务详情" activeMenu="tasks">
  <div class="max-w-[1200px]">
    <div class="mb-6">
      <a href="/admin/tasks" class="text-muted-foreground hover:text-primary text-sm mb-2 inline-block">← 返回列表</a>
      <h1 class="text-2xl font-semibold">任务详情</h1>
    </div>

    <div id="task-container">
      <TaskDetail client:load />
    </div>
  </div>
</AdminLayout>