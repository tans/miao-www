---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
import { FilterTabs } from "@/components/FilterTabs";
import { Button } from "@/components/ui/button";
import { Alert, AlertDescription } from "@/components/ui/alert";
---

<AdminLayout title="申诉管理" activeMenu="appeals">
  <div class="max-w-[1400px]">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-semibold">申诉管理</h1>
      <FilterTabs
        client:only="react"
        options={[
          { value: "", label: "全部" },
          { value: "0", label: "待处理" },
          { value: "2", label: "已处理" },
        ]}
        id="filter-tabs"
        className="mb-0"
        eventName="filter-tabs-change"
      />
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="appeals-container">
          <div class="text-center py-12 text-muted-foreground">加载中...</div>
        </div>
        <div class="flex justify-center items-center gap-4 p-4 border-t" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";
  import { toast } from "sonner";

  let currentPage = 1;
  let currentStatus = "";

  const statusMap: Record<number, { label: string; variant: "default" | "secondary" | "outline" }> = {
    0: { label: "待处理", variant: "secondary" },
    2: { label: "已处理", variant: "default" },
  };

  const typeMap: Record<number, string> = {
    1: "任务申诉",
    2: "提现申诉",
    3: "其他",
  };

  async function loadAppeals(page = 1, status = "") {
    const container = document.getElementById("appeals-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    try {
      const params: any = { page, page_size: 20 };
      if (status) params.status = parseInt(status);
      const res = await api.getAppeals(params);

      if (res.code === 0) {
        const appeals = res.data.appeals || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (appeals.length === 0) {
          container.innerHTML = `
            <Alert class="m-4">
              <AlertDescription>暂无数据</AlertDescription>
            </Alert>
          `;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>ID</TableHead>
                <TableHead>类型</TableHead>
                <TableHead>任务ID</TableHead>
                <TableHead>用户ID</TableHead>
                <TableHead>原因</TableHead>
                <TableHead>状态</TableHead>
                <TableHead>创建时间</TableHead>
                <TableHead>操作</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              ${appeals.map((appeal: any) => `
                <TableRow>
                  <TableCell class="font-mono text-xs">${appeal.id}</TableCell>
                  <TableCell>
                    <Badge variant="outline">${typeMap[appeal.type] || "未知"}</Badge>
                  </TableCell>
                  <TableCell class="font-mono text-xs">${appeal.task_id}</TableCell>
                  <TableCell class="font-mono text-xs">${appeal.user_id}</TableCell>
                  <TableCell class="max-w-64 truncate text-muted-foreground">${appeal.reason}</TableCell>
                  <TableCell>
                    <Badge variant="${statusMap[appeal.status]?.variant || "secondary"}">${statusMap[appeal.status]?.label || "未知"}</Badge>
                  </TableCell>
                  <TableCell class="text-muted-foreground text-xs">${new Date(appeal.created_at).toLocaleDateString("zh-CN")}</TableCell>
                  <TableCell>
                    <div class="flex gap-2">
                      <a href="/admin/appeal-detail?id=${appeal.id}" class="text-primary hover:underline text-sm">详情</a>
                      ${appeal.status === 0 ? `<button class="text-green-600 hover:underline text-sm" data-action="handle" data-id="${appeal.id}">处理</button>` : ""}
                    </div>
                  </TableCell>
                </TableRow>
              `).join("")}
            </TableBody>
          </Table>
        `;

        if (totalPages > 1) {
          const statusParam = status ? `&status=${status}` : "";
          paginationEl.innerHTML = `
            <Button variant="outline" size="sm" ${page <= 1 ? 'disabled' : ''} data-page="${page - 1}${statusParam}">上一页</Button>
            <span class="text-sm text-muted-foreground">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
            <Button variant="outline" size="sm" ${page >= totalPages ? 'disabled' : ''} data-page="${page + 1}${statusParam}">下一页</Button>
          `;
        } else {
          paginationEl.innerHTML = "";
        }
      } else {
        container.innerHTML = `
          <Alert variant="destructive" class="m-4">
            <AlertDescription>${res.message}</AlertDescription>
          </Alert>
        `;
        paginationEl.innerHTML = "";
      }
    } catch (e) {
      container.innerHTML = `
        <Alert variant="destructive" class="m-4">
          <AlertDescription>加载失败</AlertDescription>
        </Alert>
      `;
      paginationEl.innerHTML = "";
    }
  }

  window.addEventListener("filter-tabs-change", (e: Event) => {
    const customEvent = e as CustomEvent<{ value: string }>
    currentStatus = customEvent.detail.value
    currentPage = 1
    loadAppeals(1, currentStatus)
  })

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest("button[data-page]");
    if (btn && !btn.hasAttribute("disabled")) {
      const pageBtn = btn as HTMLElement;
      const pageMatch = pageBtn.dataset.page?.match(/^(\d+)(.*)$/);
      if (pageMatch) {
        currentPage = parseInt(pageMatch[1]);
        const newStatus = pageMatch[2]?.replace("&status=", "") || currentStatus;
        loadAppeals(currentPage, newStatus);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    }
  });

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadAppeals();
  }
</script>
