---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
import { Badge } from "@/components/ui/badge";
---

<AdminLayout title="申诉管理" activeMenu="appeals">
  <div class="appeals-page">
    <div class="page-header">
      <h1 class="page-title">申诉管理</h1>
      <div class="filter-tabs" id="filter-tabs">
        <a href="#" class="filter-tab active" data-status="">全部</a>
        <a href="#" class="filter-tab" data-status="1">待处理</a>
        <a href="#" class="filter-tab" data-status="2">已处理</a>
      </div>
    </div>

    <Card>
      <CardContent class="p-0">
        <div id="appeals-container">
          <div class="loading">加载中...</div>
        </div>
        <div class="pagination" id="pagination"></div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  let currentPage = 1;
  let currentStatus = "";

  const statusMap: Record<number, { label: string; variant: string }> = {
    1: { label: "待处理", variant: "secondary" },
    2: { label: "已处理", variant: "default" },
    3: { label: "已关闭", variant: "outline" },
  };

  const typeMap: Record<number, string> = {
    1: "任务申诉",
    2: "提现申诉",
    3: "其他",
  };

  async function loadAppeals(page = 1, status = "") {
    const container = document.getElementById("appeals-container");
    const paginationEl = document.getElementById("pagination");
    if (!container || !paginationEl) return;

    try {
      const params: any = { page, page_size: 20 };
      if (status) params.status = parseInt(status);
      const res = await api.getAppeals(params);

      if (res.code === 0) {
        const appeals = res.data.appeals || [];
        const total = res.data.total || 0;
        const totalPages = Math.ceil(total / 20);

        if (appeals.length === 0) {
          container.innerHTML = `<div class="empty-state">暂无数据</div>`;
          paginationEl.innerHTML = "";
          return;
        }

        container.innerHTML = `
          <div class="overflow-x-auto">
            <table class="appeals-table">
              <thead class="appeals-table-header">
                <tr>
                  <th class="appeals-th">ID</th>
                  <th class="appeals-th">类型</th>
                  <th class="appeals-th">任务ID</th>
                  <th class="appeals-th">用户ID</th>
                  <th class="appeals-th">原因</th>
                  <th class="appeals-th">状态</th>
                  <th class="appeals-th">创建时间</th>
                  <th class="appeals-th">操作</th>
                </tr>
              </thead>
              <tbody>
                ${appeals.map((appeal: any) => `
                  <tr class="appeals-tr">
                    <td class="appeals-td font-mono text-xs">${appeal.id}</td>
                    <td class="appeals-td">
                      <span class="appeals-badge appeals-badge-outline">${typeMap[appeal.type] || "未知"}</span>
                    </td>
                    <td class="appeals-td font-mono text-xs">${appeal.task_id}</td>
                    <td class="appeals-td font-mono text-xs">${appeal.user_id}</td>
                    <td class="appeals-td max-w-xs truncate text-muted">${appeal.reason}</td>
                    <td class="appeals-td">
                      <span class="appeals-badge appeals-badge-${statusMap[appeal.status]?.variant || "secondary"}">${statusMap[appeal.status]?.label || "未知"}</span>
                    </td>
                    <td class="appeals-td text-muted text-xs">${new Date(appeal.created_at).toLocaleDateString("zh-CN")}</td>
                    <td class="appeals-td">
                      <div class="flex gap-2">
                        <a href="/admin/appeal-detail?id=${appeal.id}" class="text-primary hover:underline text-sm">详情</a>
                        ${appeal.status === 1 ? `<button class="text-green-600 hover:underline text-sm" data-action="handle" data-id="${appeal.id}">处理</button>` : ""}
                      </div>
                    </td>
                  </tr>
                `).join("")}
              </tbody>
            </table>
          </div>
        `;

        const statusParam = status ? `&status=${status}` : "";
        paginationEl.innerHTML = totalPages > 1 ? `
          <a href="#" class="page-btn ${page <= 1 ? 'disabled' : ''}" data-page="${page - 1}${statusParam}">上一页</a>
          <span class="page-info">第 ${page} / ${totalPages} 页，共 ${total} 条</span>
          <a href="#" class="page-btn ${page >= totalPages ? 'disabled' : ''}" data-page="${page + 1}${statusParam}">下一页</a>
        ` : "";
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  document.getElementById("filter-tabs")?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("filter-tab")) {
      e.preventDefault();
      document.querySelectorAll(".filter-tab").forEach(el => el.classList.remove("active"));
      target.classList.add("active");
      currentStatus = target.dataset.status || "";
      currentPage = 1;
      loadAppeals(1, currentStatus);
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains("page-btn") && !target.classList.contains("disabled")) {
      e.preventDefault();
      const pageMatch = target.dataset.page?.match(/^(\d+)(.*)$/);
      if (pageMatch) {
        currentPage = parseInt(pageMatch[1]);
        const newStatus = pageMatch[2]?.replace("&status=", "") || currentStatus;
        loadAppeals(currentPage, newStatus);
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    }
  });

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadAppeals();
  }
</script>

<style>
  .appeals-page {
    max-width: 1400px;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .filter-tabs {
    display: flex;
    gap: 0.25rem;
    background: white;
    padding: 0.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--admin-border);
  }

  .filter-tab {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--admin-text-muted);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: all 0.2s;
  }

  .filter-tab:hover {
    color: var(--admin-text);
    background: var(--admin-bg);
  }

  .filter-tab.active {
    background: var(--admin-primary);
    color: white;
  }

  .loading, .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--admin-text-muted);
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
    margin: 1rem;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-top: 1px solid var(--admin-border);
  }

  .page-btn {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--admin-text);
    text-decoration: none;
    border: 1px solid var(--admin-border);
    border-radius: 0.375rem;
  }

  .page-btn:hover:not(.disabled) {
    border-color: var(--admin-primary);
    color: var(--admin-primary);
  }

  .page-btn.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .page-info {
    font-size: 0.875rem;
    color: var(--admin-text-muted);
  }
</style>
