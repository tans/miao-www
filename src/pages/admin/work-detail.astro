---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
---

<AdminLayout title="作品详情" activeMenu="works">
  <div class="work-detail-page">
    <div class="page-header">
      <a href="/admin/works" class="back-link">← 返回列表</a>
      <h1 class="page-title">作品详情</h1>
    </div>

    <div id="work-container">
      <div class="loading">加载中...</div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  const urlParams = new URLSearchParams(window.location.search);
  const workId = urlParams.get("id");

  if (!workId) {
    document.getElementById("work-container")!.innerHTML = `<div class="error-message">缺少作品ID参数</div>`;
  }

  const statusMap: Record<number, { label: string; class: string }> = {
    1: { label: "待审核", class: "bg-yellow-100 text-yellow-800" },
    2: { label: "已通过", class: "bg-green-100 text-green-800" },
    3: { label: "未通过", class: "bg-red-100 text-red-800" },
  };

  async function loadWork() {
    const container = document.getElementById("work-container");
    if (!container || !workId) return;

    try {
      const res = await api.getWorkDetail(parseInt(workId));
      if (res.code === 0) {
        const work = res.data.work;
        container.innerHTML = `
          <div class="detail-grid">
            <Card class="col-span-2">
              <CardHeader>
                <CardTitle>作品信息</CardTitle>
              </CardHeader>
              <CardContent class="info-list">
                <div class="info-item">
                  <span class="info-label">作品ID</span>
                  <span class="info-value font-mono">${work.id}</span>
                </div>
                <div class="info-item">
                  <span class="info-label">任务ID</span>
                  <span class="info-value font-mono"><a href="/admin/task-detail?id=${work.task_id}" class="link">${work.task_id}</a></span>
                </div>
                <div class="info-item">
                  <span class="info-label">认领ID</span>
                  <span class="info-value font-mono">${work.claim_id}</span>
                </div>
                <div class="info-item">
                  <span class="info-label">创作者ID</span>
                  <span class="info-value font-mono"><a href="/admin/user-detail?id=${work.creator_id}" class="link">${work.creator_id}</a></span>
                </div>
                <div class="info-item">
                  <span class="info-label">状态</span>
                  <span class="info-value"><span class="badge ${statusMap[work.status]?.class || "bg-gray-100"}">${statusMap[work.status]?.label || "未知"}</span></span>
                </div>
                <div class="info-item">
                  <span class="info-label">审核结果</span>
                  <span class="info-value">${work.review_result === 1 ? "通过" : work.review_result === 2 ? "未通过" : "待审核"}</span>
                </div>
                <div class="info-item">
                  <span class="info-label">提交时间</span>
                  <span class="info-value">${work.created_at ? new Date(work.created_at).toLocaleString("zh-CN") : "-"}</span>
                </div>
                <div class="info-item">
                  <span class="info-label">审核时间</span>
                  <span class="info-value">${work.review_at ? new Date(work.review_at).toLocaleString("zh-CN") : "-"}</span>
                </div>
              </CardContent>
            </Card>

            <Card class="col-span-2">
              <CardHeader>
                <CardTitle>作品内容</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="work-content">${work.content || "无文字内容"}</div>
              </CardContent>
            </Card>

            ${work.images && work.images.length > 0 ? `
            <Card class="col-span-2">
              <CardHeader>
                <CardTitle>图片 (${work.images.length})</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="images-grid">
                  ${work.images.map((img: string) => `
                    <div class="image-item">
                      <img src="${img}" alt="作品图片" />
                    </div>
                  `).join("")}
                </div>
              </CardContent>
            </Card>
            ` : ""}

            ${work.videos && work.videos.length > 0 ? `
            <Card class="col-span-2">
              <CardHeader>
                <CardTitle>视频 (${work.videos.length})</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="videos-list">
                  ${work.videos.map((video: string) => `
                    <div class="video-item">
                      <video controls src="${video}"></video>
                    </div>
                  `).join("")}
                </div>
              </CardContent>
            </Card>
            ` : ""}

            <Card>
              <CardHeader>
                <CardTitle>操作</CardTitle>
              </CardHeader>
              <CardContent class="actions">
                ${work.status === 1 ? `
                <button class="btn btn-success" id="approve-btn">通过</button>
                <button class="btn btn-danger" id="reject-btn">拒绝</button>
                ` : ""}
                <button class="btn btn-outline" id="delete-btn">删除</button>
              </CardContent>
            </Card>
          </div>
        `;

        document.getElementById("approve-btn")?.addEventListener("click", async () => {
          if (!confirm("确定通过该作品？")) return;
          try {
            const res = await api.updateWork(parseInt(workId), { status: 2, review_result: 1 });
            if (res.code === 0) {
              alert("已通过");
              loadWork();
            } else {
              alert("操作失败: " + res.message);
            }
          } catch (e) {
            alert("操作失败");
          }
        });

        document.getElementById("reject-btn")?.addEventListener("click", async () => {
          if (!confirm("确定拒绝该作品？")) return;
          try {
            const res = await api.updateWork(parseInt(workId), { status: 3, review_result: 2 });
            if (res.code === 0) {
              alert("已拒绝");
              loadWork();
            } else {
              alert("操作失败: " + res.message);
            }
          } catch (e) {
            alert("操作失败");
          }
        });

        document.getElementById("delete-btn")?.addEventListener("click", async () => {
          if (!confirm("确定删除该作品？此操作不可恢复。")) return;
          try {
            const res = await api.deleteWork(parseInt(workId));
            if (res.code === 0) {
              alert("已删除");
              window.location.href = "/admin/works";
            } else {
              alert("删除失败: " + res.message);
            }
          } catch (e) {
            alert("删除失败");
          }
        });
      } else {
        container.innerHTML = `<div class="error-message">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="error-message">加载失败</div>`;
    }
  }

  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadWork();
  }
</script>

<style>
  .work-detail-page {
    max-width: 1200px;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  .back-link:hover {
    color: var(--primary);
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .loading {
    text-align: center;
    padding: 3rem;
    color: var(--text-muted);
  }

  .error-message {
    padding: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #dc2626;
    border-radius: 0.5rem;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .col-span-2 {
    grid-column: span 2;
  }

  @media (max-width: 768px) {
    .col-span-2 {
      grid-column: span 1;
    }
  }

  :global(.info-list) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .info-item:last-child {
    border-bottom: none;
  }

  .info-label {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .info-value {
    font-weight: 500;
  }

  .link {
    color: var(--primary);
    text-decoration: none;
  }

  .link:hover {
    text-decoration: underline;
  }

  .badge {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .work-content {
    white-space: pre-wrap;
    line-height: 1.6;
    color: var(--text);
  }

  .images-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
  }

  .image-item img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
  }

  .videos-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .video-item video {
    width: 100%;
    max-height: 400px;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
  }

  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.625rem 1.5rem;
    border: none;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-success {
    background: #10b981;
    color: white;
  }

  .btn-success:hover {
    background: #059669;
  }

  .btn-danger {
    background: #ef4444;
    color: white;
  }

  .btn-danger:hover {
    background: #dc2626;
  }

  .btn-outline {
    background: white;
    border: 1px solid var(--border);
    color: var(--text);
  }

  .btn-outline:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
</style>
