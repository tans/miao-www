---
import "@/styles/global.css";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
import { Alert, AlertDescription } from "@/components/ui/alert";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>管理后台登录 - 创意喵</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-red-50 via-pink-50 to-fuchsia-100">
      <div class="w-full max-w-md">
        <Card class="bg-white rounded-2xl shadow-[0_20px_60px_rgba(0,0,0,0.1)] overflow-hidden">
          <CardHeader class="text-center pb-6 pt-8 px-6">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-pink-500 to-rose-500 rounded-2xl mb-4 text-white">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <CardTitle class="text-xl font-semibold text-foreground mb-1">创意喵管理后台</CardTitle>
            <CardDescription>请登录以继续</CardDescription>
          </CardHeader>
          <CardContent class="px-6 pb-8">
            <form id="login-form" class="flex flex-col gap-4">
              <div class="flex flex-col gap-2">
                <Label htmlFor="username" class="text-sm font-medium text-foreground">用户名</Label>
                <Input
                  type="text"
                  id="username"
                  name="username"
                  placeholder="请输入用户名"
                  required
                  autoComplete="username"
                />
              </div>
              <div class="flex flex-col gap-2">
                <Label htmlFor="password" class="text-sm font-medium text-foreground">密码</Label>
                <Input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="请输入密码"
                  required
                  autoComplete="current-password"
                />
              </div>
              <div id="error-message" class="hidden">
                <Alert variant="destructive">
                  <AlertDescription id="error-text"></AlertDescription>
                </Alert>
              </div>
              <Button type="submit" class="w-full py-3 bg-gradient-to-br from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all hover:-translate-y-0.5 disabled:opacity-70 disabled:cursor-not-allowed disabled:hover:translate-y-0" id="submit-btn">
                登录
              </Button>
            </form>
          </CardContent>
        </Card>
      </div>
    </div>

    <script>
      import { api } from "@/lib/api";
      import { toast } from "sonner";

      const form = document.getElementById("login-form") as HTMLFormElement;
      const errorEl = document.getElementById("error-message") as HTMLDivElement;
      const errorText = document.getElementById("error-text") as HTMLDivElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.classList.add("hidden");
        submitBtn.disabled = true;
        submitBtn.textContent = "登录中...";

        const formData = new FormData(form);
        const username = formData.get("username") as string;
        const password = formData.get("password") as string;

        try {
          const res = await api.adminLogin(username, password);
          if (res.code === 0) {
            api.setToken(res.data.token);
            localStorage.setItem("username", username);
            localStorage.setItem("current_role", "admin");
            toast.success("登录成功");
            window.location.href = "/admin";
          } else {
            errorText.textContent = res.message || "登录失败";
            errorEl.classList.remove("hidden");
            submitBtn.disabled = false;
            submitBtn.textContent = "登录";
          }
        } catch (err) {
          errorText.textContent = "网络错误，请稍后重试";
          errorEl.classList.remove("hidden");
          submitBtn.disabled = false;
          submitBtn.textContent = "登录";
        }
      });
    </script>
  </body>
</html>
