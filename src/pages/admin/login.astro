---
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>管理后台登录 - 创意喵</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="login-page">
      <div class="login-container">
        <Card class="login-card">
          <CardHeader class="login-header">
            <div class="logo">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <CardTitle>创意喵管理后台</CardTitle>
            <CardDescription>请登录以继续</CardDescription>
          </CardHeader>
          <CardContent>
            <form id="login-form" class="login-form">
              <div class="form-group">
                <Label for="username">用户名</Label>
                <Input
                  type="text"
                  id="username"
                  name="username"
                  placeholder="请输入用户名"
                  required
                  autocomplete="username"
                />
              </div>
              <div class="form-group">
                <Label for="password">密码</Label>
                <Input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="请输入密码"
                  required
                  autocomplete="current-password"
                />
              </div>
              <div id="error-message" class="error-message" style="display: none;"></div>
              <Button type="submit" class="login-btn" id="submit-btn">
                登录
              </Button>
            </form>
          </CardContent>
        </Card>
      </div>
    </div>

    <script>
      import { api } from "@/lib/api";
      import { toast } from "sonner";

      const form = document.getElementById("login-form") as HTMLFormElement;
      const errorEl = document.getElementById("error-message") as HTMLDivElement;
      const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorEl.style.display = "none";
        submitBtn.disabled = true;
        submitBtn.textContent = "登录中...";

        const formData = new FormData(form);
        const username = formData.get("username") as string;
        const password = formData.get("password") as string;

        try {
          const res = await api.adminLogin(username, password);
          if (res.code === 0) {
            api.setToken(res.data.token);
            localStorage.setItem("username", username);
            localStorage.setItem("current_role", "admin");
            toast.success("登录成功");
            window.location.href = "/admin";
          } else {
            errorEl.textContent = res.message || "登录失败";
            errorEl.style.display = "block";
            submitBtn.disabled = false;
            submitBtn.textContent = "登录";
          }
        } catch (err) {
          errorEl.textContent = "网络错误，请稍后重试";
          errorEl.style.display = "block";
          submitBtn.disabled = false;
          submitBtn.textContent = "登录";
        }
      });
    </script>

    <style>
      :root {
        --primary: #e94560;
        --primary-hover: #d63d56;
        --bg: #f5f6f8;
        --text: #2d3436;
        --text-muted: #636e72;
        --border: #e5e5e5;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Outfit", -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
      }

      .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: linear-gradient(135deg, #fef2f2 0%, #fdf4f4 50%, #fce7f3 100%);
      }

      .login-container {
        width: 100%;
        max-width: 400px;
      }

      .login-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
        overflow: hidden;
      }

      .login-header {
        text-align: center;
        padding: 2rem 1.5rem 1.5rem;
        border-bottom: none;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, var(--primary) 0%, #ff6b81 100%);
        border-radius: 1rem;
        margin-bottom: 1rem;
        color: white;
      }

      :global(.card-title) {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.25rem;
      }

      :global(.card-description) {
        font-size: 0.875rem;
        color: var(--text-muted);
      }

      :global(.login-card .card-content) {
        padding: 1.5rem;
      }

      .login-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      :global(.form-group label) {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text);
      }

      :global(.form-group input) {
        padding: 0.625rem 0.875rem;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        font-size: 0.9375rem;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      :global(.form-group input:focus) {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(233, 69, 96, 0.1);
      }

      .error-message {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        padding: 0.75rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
      }

      .login-btn {
        width: 100%;
        padding: 0.75rem;
        background: linear-gradient(135deg, var(--primary) 0%, #ff6b81 100%);
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .login-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(233, 69, 96, 0.3);
      }

      .login-btn:active:not(:disabled) {
        transform: translateY(0);
      }

      .login-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
      }
    </style>
  </body>
</html>
