---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";
---

<AdminLayout title="数据概览" activeMenu="dashboard">
  <div class="dashboard">
    <h1 class="page-title">数据概览</h1>

    <div class="stats-grid" id="stats-container">
      <div class="loading">加载中...</div>
    </div>
  </div>
</AdminLayout>

<script>
  import { api } from "@/lib/api";

  async function loadDashboard() {
    const container = document.getElementById("stats-container");
    if (!container) return;

    try {
      const res = await api.getDashboard();
      if (res.code === 0) {
        const stats = res.data;
        container.innerHTML = `
          <div class="stats-grid">
            <Card>
              <CardHeader class="pb-2">
                <CardTitle class="text-sm font-normal text-muted-foreground">总用户数</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="text-2xl font-bold">${stats.total_users}</div>
                <p class="text-xs text-muted-foreground">人</p>
              </CardContent>
            </Card>

            <Card>
              <CardHeader class="pb-2">
                <CardTitle class="text-sm font-normal text-muted-foreground">总任务数</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="text-2xl font-bold">${stats.total_tasks}</div>
                <p class="text-xs text-muted-foreground">个</p>
              </CardContent>
            </Card>

            <Card class="border-primary/50">
              <CardHeader class="pb-2">
                <CardTitle class="text-sm font-normal text-muted-foreground">进行中任务</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="text-2xl font-bold text-primary">${stats.active_tasks}</div>
                <p class="text-xs text-muted-foreground">个</p>
              </CardContent>
            </Card>

            <Card>
              <CardHeader class="pb-2">
                <CardTitle class="text-sm font-normal text-muted-foreground">总作品数</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="text-2xl font-bold">${stats.total_works}</div>
                <p class="text-xs text-muted-foreground">个</p>
              </CardContent>
            </Card>

            <Card class="border-yellow-500/50">
              <CardHeader class="pb-2">
                <CardTitle class="text-sm font-normal text-muted-foreground">待审核任务</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="text-2xl font-bold text-yellow-600">${stats.pending_tasks}</div>
                <p class="text-xs text-muted-foreground">个</p>
              </CardContent>
            </Card>

            <Card class="border-orange-500/50">
              <CardHeader class="pb-2">
                <CardTitle class="text-sm font-normal text-muted-foreground">待处理申诉</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="text-2xl font-bold text-orange-600">${stats.pending_appeals}</div>
                <p class="text-xs text-muted-foreground">个</p>
              </CardContent>
            </Card>

            <Card>
              <CardHeader class="pb-2">
                <CardTitle class="text-sm font-normal text-muted-foreground">总收入</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="text-2xl font-bold text-green-600">¥${(stats.total_revenue || 0).toFixed(2)}</div>
              </CardContent>
            </Card>

            <Card>
              <CardHeader class="pb-2">
                <CardTitle class="text-sm font-normal text-muted-foreground">今日收入</CardTitle>
              </CardHeader>
              <CardContent>
                <div class="text-2xl font-bold text-green-600">¥${(stats.today_revenue || 0).toFixed(2)}</div>
              </CardContent>
            </Card>
          </div>
        `;
      } else {
        container.innerHTML = `<div class="text-destructive text-sm p-4">${res.message}</div>`;
      }
    } catch (e) {
      container.innerHTML = `<div class="text-destructive text-sm p-4">加载失败，请刷新页面</div>`;
    }
  }

  // Check auth first
  const token = localStorage.getItem('admin_token');
  if (!token) {
    window.location.href = '/admin/login';
  } else {
    loadDashboard();
  }
</script>

<style>
  .dashboard {
    max-width: 1400px;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--admin-text);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
</style>
