---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Dashboard } from "@/components/admin/Dashboard";
---

<AdminLayout title="数据概览" activeMenu="dashboard">
  <div class="max-w-[1400px]">
    <div class="mb-6 flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold">数据概览</h1>
      <a
        href="/admin/screen"
        target="_blank"
        rel="noreferrer"
        class="inline-flex h-8 items-center justify-center rounded-lg border border-border bg-background px-3 text-sm font-medium text-foreground transition-colors hover:bg-muted"
      >
        打开数据大屏
      </a>
    </div>
    <Dashboard client:load />
  </div>
</AdminLayout>
